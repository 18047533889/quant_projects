  "code": "def factor_volume_instability(df):\n    df_copy = df.copy()\n    vol_mean = df_copy[\"volume\"].rolling(20, min_periods=20).mean()\n    vol_std = df_copy[\"volume\"].rolling(20, min_periods=20).std(ddof=1)\n    cv = vol_std / vol_mean.replace(0.0, np.nan)\n    cv = cv.replace([np.inf, -np.inf], np.nan)\n    df_copy[\"factor_volume_instability\"] = cv\n    return df_copy[\"factor_volume_instability\"]",
