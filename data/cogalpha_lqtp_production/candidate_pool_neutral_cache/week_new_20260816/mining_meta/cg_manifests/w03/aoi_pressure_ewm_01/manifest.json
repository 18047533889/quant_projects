  "code": "def factor_pressure_ewm_smooth(df):\n    df_copy = df.copy()\n    overnight_ret = df_copy['open'] / df_copy['close'].shift(1) - 1.0\n    intraday_ret = df_copy['close'] / df_copy['open'] - 1.0\n    pressure = intraday_ret - overnight_ret\n    smoothed = pressure.ewm(span=5, adjust=False).mean()\n    df_copy['factor_pressure_ewm_smooth'] = smoothed\n    return df_copy['factor_pressure_ewm_smooth']",
