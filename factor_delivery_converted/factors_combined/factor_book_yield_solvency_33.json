  "code": "def factor_book_yield_solvency(df):\n    df_copy = df.copy()\n    book_yield = 1.0 / df_copy[\"pb_lf\"].replace(0, np.nan)\n    solvency = (1.0 - df_copy[\"debttoassets\"].abs() / 100.0).clip(lower=0)\n    df_copy[\"factor_book_yield_solvency\"] = book_yield * solvency\n    return df_copy[\"factor_book_yield_solvency\"]",
