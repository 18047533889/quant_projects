  "code": "def factor_drawdown_recovery_dnratio20_ema3(df):\n    df_copy = df.copy()\n    high = df_copy['high']\n    low = df_copy['low']\n    close = df_copy['close']\n    rolling_max = close.rolling(window=252, min_periods=20).max()\n    drawdown = (close - rolling_max) / rolling_max\n    tr = np.maximum(high - low,\n                    np.maximum((high - low.shift(1)).abs(),\n                               (low - high.shift(1)).abs()))\n    atr = tr.rolling(window=20, min_periods=10).mean()\n    normalizer = atr / close\n    normalizer = normalizer.replace(0, np.nan)\n    base_factor = -drawdown / normalizer\n    ret = close.pct_change()\n    neg_ret = ret.where(ret < 0, 0.0)\n    down_vol = neg_ret.rolling(window=20, min_periods=20).std(ddof=1)\n    total_vol = ret.rolling(window=20, min_periods=20).std(ddof=1)\n    total_vol_safe = total_vol.replace(0, np.nan)\n    downside_ratio = down_vol / total_vol_safe\n    downside_ratio = downside_ratio.fillna(0.5)\n    factor = base_factor * (1.0 + 0.3 * downside_ratio)\n    factor = factor.fillna(0)\n    factor_arr = talib.EMA(factor.values, timeperiod=3)\n    factor = pd.Series(factor_arr, index=df_copy.index).fillna(0)\n    factor.name = 'factor_drawdown_recovery_dnratio20_ema3'\n    return factor",
