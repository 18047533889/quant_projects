  "code": "def factor_volume_adjusted_price_range(df):\n    df_copy = df.copy()\n    high_low = df_copy['high'] - df_copy['low']\n    volume_ema = df_copy['volume'].ewm(span=10, adjust=False).mean().replace(0, np.nan)\n    volume_ratio = df_copy['volume'] / volume_ema\n    volume_ratio = volume_ratio.replace([np.inf, -np.inf], np.nan)\n    raw_signal = high_low * volume_ratio\n    smoothed = raw_signal.rolling(window=5, min_periods=5).mean()\n    gate = df_copy['style_gate_resvol_high']\n    factor = np.where(gate > 0, smoothed * 1.2, smoothed * 0.8)\n    df_copy['factor_volume_adjusted_price_range'] = factor\n    return df_copy['factor_volume_adjusted_price_range']",
