  "code": "def factor_downside_vol_asym_inverted(df):\n    df_copy = df.copy()\n    close = df_copy['close']\n    ret = close / close.shift(1) - 1.0\n    pos_ret = ret.where(ret > 0, 0.0)\n    neg_ret = ret.where(ret < 0, 0.0)\n    window = 60\n    vol_up = pos_ret.rolling(window, min_periods=int(window/2)).std(ddof=1)\n    vol_down = neg_ret.rolling(window, min_periods=int(window/2)).std(ddof=1)\n    vol_ratio = vol_down / vol_up.replace(0, np.nan)\n    vol_ratio = vol_ratio.replace([np.inf, -np.inf], np.nan)\n    smoothed_vol_ratio = vol_ratio.ewm(span=20, min_periods=10).mean()\n    factor = -smoothed_vol_ratio.fillna(0)\n    df_copy['factor_downside_vol_asym_inverted'] = factor\n    return df_copy['factor_downside_vol_asym_inverted']",
