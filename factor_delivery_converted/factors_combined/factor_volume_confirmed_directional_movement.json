  "code": "def factor_volume_confirmed_directional_movement(df):\n    df_copy = df.copy()\n    prev_close = df_copy['close'].shift(1)\n    buy = (df_copy['high'] - prev_close) * df_copy['volume']\n    sell = (prev_close - df_copy['low']) * df_copy['volume']\n    window = 20\n    net = (buy.rolling(window).sum() - sell.rolling(window).sum()) / df_copy['volume'].rolling(window).sum().replace(0, np.nan)\n    factor = net.ewm(span=10).mean()\n    factor.name = \"factor_volume_confirmed_directional_movement\"\n    return factor",
