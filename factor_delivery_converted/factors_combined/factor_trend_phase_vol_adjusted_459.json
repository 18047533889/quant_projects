  "code": "def factor_trend_phase_vol_adjusted(df):\n    df_copy = df.copy()\n    ema50 = talib.EMA(df_copy[\"close\"], timeperiod=50)\n    ema200 = talib.EMA(df_copy[\"close\"], timeperiod=200)\n    trend_diff = (ema50 - ema200) / df_copy[\"close\"]\n    atr = talib.ATR(df_copy[\"high\"], df_copy[\"low\"], df_copy[\"close\"], timeperiod=14)\n    vol_factor = 1 - (atr / df_copy[\"close\"]).replace(np.inf, np.nan).fillna(0)\n    factor = trend_diff * vol_factor\n    df_copy[\"factor_trend_phase_vol_adjusted\"] = factor\n    return df_copy[\"factor_trend_phase_vol_adjusted\"]",
