  "code": "def factor_growth_adjusted_earnings_yield_rolling(df):\n    df_copy = df.copy()\n    inv_pe = 1.0 / df_copy[\"pe_ttm\"].replace(0, np.nan)\n    growth = df_copy[\"forecast_incap_chgr_mid\"]\n    inv_pe_rank = inv_pe.rolling(60, min_periods=20).rank(pct=True)\n    growth_rank = growth.rolling(60, min_periods=20).rank(pct=True)\n    factor = inv_pe_rank * (1 + growth_rank)\n    factor.name = \"factor_growth_adjusted_earnings_yield_rolling\"\n    return factor",
