  "code": "def factor_price_impact_volatility_adjusted_v2(df):\n    df_copy = df.copy()\n    close = df_copy['close']\n    high = df_copy['high']\n    low = df_copy['low']\n    volume = df_copy['volume']\n    ret = close / close.shift(1) - 1.0\n    abs_ret = ret.abs()\n    # Shorter window for price impact to capture recent liquidity changes\n    impact = abs_ret / volume.replace(0, np.nan)\n    avg_impact = impact.rolling(10, min_periods=10).mean()\n    # Range-based volatility using ATR normalized by close - more robust\n    tr = np.maximum(high - low, np.maximum((high - close.shift(1)).abs(), (low - close.shift(1)).abs()))\n    atr = tr.rolling(20, min_periods=20).mean()\n    atr_normalized = atr / close\n    # Volatility-adjusted impact\n    factor = avg_impact / atr_normalized.replace(0, np.nan)\n    factor = factor.replace([np.inf, -np.inf], np.nan).fillna(0)\n    df_copy['factor_price_impact_volatility_adjusted_v2'] = factor\n    return df_copy['factor_price_impact_volatility_adjusted_v2']",
