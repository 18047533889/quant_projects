  "code": "def factor_price_smoothness_sma(df):\n    df_copy = df.copy()\n    daily_ret = df_copy[\"close\"] / df_copy[\"close\"].shift(1) - 1\n    daily_range = df_copy[\"high\"] - df_copy[\"low\"]\n    smoothness_ratio = (daily_ret ** 2) / (daily_range ** 2).replace(0, np.nan)\n    sma_ratio = smoothness_ratio.rolling(window=15, min_periods=10).mean()\n    factor = -sma_ratio\n    df_copy[\"factor_price_smoothness_sma\"] = factor\n    return df_copy[\"factor_price_smoothness_sma\"]",
