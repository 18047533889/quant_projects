  "code": "def factor_drawdown_stress_ratio(df):\n    df_copy = df.copy()\n    rolling_max = df_copy['close'].rolling(20, min_periods=10).max()\n    max_drawdown_20 = (df_copy['close'] - rolling_max) / rolling_max\n    high_low_range = (df_copy['high'] - df_copy['low']).rolling(20, min_periods=10).mean()\n    stress_ratio = -max_drawdown_20 / high_low_range.replace(0.0, np.nan)\n    df_copy['factor_drawdown_stress_ratio'] = stress_ratio.fillna(0.0)\n    return df_copy['factor_drawdown_stress_ratio']",
