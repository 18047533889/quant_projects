  "code": "def factor_recovery_drawdown_saturated(df):\n    \"\"\"Measure persistent recovery from a prior drawdown with bounded recovery amplitude.\"\"\"\n    df_copy = df.copy()\n    close = df_copy[\"close\"]\n    low = df_copy[\"low\"]\n    prior_peak = close.rolling(30, min_periods=30).max().shift(5)\n    drawdown_depth = (1.0 - close.shift(5) / prior_peak).clip(lower=0.0, upper=0.8)\n    prior_low = low.rolling(15, min_periods=15).min().shift(1).replace(0.0, np.nan)\n    recovery = close / prior_low - 1.0\n    recovery_score = recovery.ewm(span=6, adjust=False, min_periods=6).mean() - 0.5 * drawdown_depth\n    factor = np.tanh(2.0 * recovery_score) * (0.75 + 0.75 * drawdown_depth)\n    df_copy[\"factor_recovery_drawdown_saturated\"] = factor\n    return df_copy[\"factor_recovery_drawdown_saturated\"]",
