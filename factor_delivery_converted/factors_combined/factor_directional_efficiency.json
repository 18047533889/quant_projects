  "code": "def factor_directional_efficiency(df):\n    df_copy = df.copy()\n    close = df_copy['close']\n    high = df_copy['high']\n    low = df_copy['low']\n    ret = close.pct_change().abs()\n    range_ = high - low\n    # avoid division by zero and small ranges\n    range_ = range_.clip(lower=1e-8)\n    efficiency = ret / range_\n    df_copy['factor_directional_efficiency'] = efficiency.rolling(10).median()\n    return df_copy['factor_directional_efficiency']",
