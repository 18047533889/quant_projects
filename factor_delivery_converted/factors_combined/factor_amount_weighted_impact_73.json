  "code": "def factor_amount_weighted_impact(df):\n    df_copy = df.copy()\n    ret = df_copy[\"close_price\"].pct_change().abs().fillna(0.0)\n    impact = minute_tools.amount_weighted_mean(ret, df_copy[\"amount\"], df_copy[\"TradingDay\"])\n    value = float(impact)\n    day = pd.Timestamp(df_copy[\"TradingDay\"].iloc[0])\n    out = pd.Series([value], index=[day], name=\"factor_amount_weighted_impact\")\n    return out",
