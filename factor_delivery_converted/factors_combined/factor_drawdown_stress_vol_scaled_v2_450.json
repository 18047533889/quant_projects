  "code": "def factor_drawdown_stress_vol_scaled_v2(df):\n    df_copy = df.copy()\n    close = df_copy[\"close\"]\n    rolling_max = close.rolling(40, min_periods=40).max()\n    in_drawdown = close < rolling_max * 0.95\n    occupancy = in_drawdown.rolling(10, min_periods=10).sum() / 10.0\n    depth = (close / rolling_max) - 1.0\n    stress = -depth * occupancy\n    ret = close.pct_change()\n    vol = ret.rolling(20, min_periods=10).std(ddof=1).replace(0.0, np.nan)\n    vol_attenuation = 1.0 / (1.0 + 2.0 * vol)\n    stress_scaled = stress * vol_attenuation\n    stress_scaled = stress_scaled.fillna(0.0)\n    df_copy[\"factor_drawdown_stress_vol_scaled_v2\"] = stress_scaled\n    return df_copy[\"factor_drawdown_stress_vol_scaled_v2\"]",
