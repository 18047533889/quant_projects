  "code": "def factor_improving_quality_value(df):\n    df_copy = df.copy()\n    pb = df_copy[\"pb_lf\"]\n    cheapness = 1.0 / pb.replace(0, np.nan)\n    cheapness = cheapness.where(pb > 0, np.nan)\n    roe = df_copy[\"roe_ttm2\"] / 100.0\n    roe_delta = roe - roe.shift(4)\n    rev_growth = df_copy[\"qfa_yoygr\"] / 100.0\n    roe_delta_clipped = roe_delta.clip(-0.9, 10)\n    rev_growth_clipped = rev_growth.clip(-0.9, 10)\n    composite = cheapness * (1 + roe_delta_clipped) * (1 + rev_growth_clipped)\n    composite = composite.replace([np.inf, -np.inf], np.nan)\n    composite.name = \"factor_improving_quality_value\"\n    return composite",
