  "code": "def factor_stability_atr(df):\n    df_copy = df.copy()\n    high = df_copy[\"high\"].values.astype(np.float64)\n    low = df_copy[\"low\"].values.astype(np.float64)\n    close = df_copy[\"close\"].values.astype(np.float64)\n    atr_values = talib.ATR(high, low, close, timeperiod=20)\n    atr = pd.Series(atr_values, index=df_copy.index)\n    mean_atr = atr.rolling(20, min_periods=10).mean()\n    std_atr = atr.rolling(20, min_periods=10).std()\n    cv = std_atr / mean_atr.replace(0, np.nan)\n    factor = 1.0 / (1.0 + cv**2)\n    df_copy[\"factor_stability_atr\"] = factor\n    return df_copy[\"factor_stability_atr\"]",
