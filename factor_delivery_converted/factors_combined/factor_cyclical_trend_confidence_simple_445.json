  "code": "def factor_cyclical_trend_confidence_simple(df):\n    df_copy = df.copy()\n    pdi = pd.Series(talib.PLUS_DI(df_copy['high'], df_copy['low'], df_copy['close'], timeperiod=50), index=df_copy.index)\n    mdi = pd.Series(talib.MINUS_DI(df_copy['high'], df_copy['low'], df_copy['close'], timeperiod=50), index=df_copy.index)\n    di_spread = pdi - mdi\n    factor = pd.Series(talib.EMA(di_spread, timeperiod=20), index=df_copy.index)\n    df_copy['factor_cyclical_trend_confidence_simple'] = factor\n    return df_copy['factor_cyclical_trend_confidence_simple']",
