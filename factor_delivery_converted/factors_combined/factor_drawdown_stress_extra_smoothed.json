  "code": "def factor_drawdown_stress_extra_smoothed(df):\n    df_copy = df.copy()\n    peak_high = df_copy['high'].rolling(60, min_periods=60).max()\n    drawdown = (df_copy['close'] - peak_high) / peak_high.replace(0, np.nan)\n    max_drawdown = drawdown.rolling(60, min_periods=60).min()\n    atr = talib.ATR(df_copy['high'], df_copy['low'], df_copy['close'], timeperiod=14)\n    stress = -max_drawdown / atr.replace(0, np.nan)\n    factor = stress.rolling(10, min_periods=10).mean()\n    factor = factor.replace([np.inf, -np.inf], np.nan).fillna(0.0)\n    df_copy['factor_drawdown_stress_extra_smoothed'] = factor\n    return df_copy['factor_drawdown_stress_extra_smoothed']",
