  "code": "def factor_attentive_sales_yield_winsorized(df):\n    df_copy = df.copy()\n    sales_yield = 1.0 / df_copy[\"ps_ttm\"].replace(0, np.nan)\n    inattention = 1.0 - df_copy[\"free_turn\"].rolling(20, min_periods=1).rank(pct=True)\n    sales_yield = sales_yield.ffill()\n    inattention = inattention.ffill()\n    raw = sales_yield * inattention\n    low = raw.rolling(60, min_periods=10).quantile(0.05)\n    high = raw.rolling(60, min_periods=10).quantile(0.95)\n    winsorized = raw.clip(lower=low, upper=high)\n    df_copy[\"factor_attentive_sales_yield_winsorized\"] = winsorized\n    return df_copy[\"factor_attentive_sales_yield_winsorized\"]",
  "cross_sectional_rationale": "Sales yield and inattention are inherently cross-sectional; ranking after winsorization emphasizes relative value-attention across stocks.",
