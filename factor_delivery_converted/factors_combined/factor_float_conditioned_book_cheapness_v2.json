  "code": "def factor_float_conditioned_book_cheapness_v2(df):\n    df_copy = df.copy()\n    cheapness = 1.0 / df_copy[\"pb_lf\"].replace(0, np.nan)\n    size_adj = 1.0 / np.log1p(df_copy[\"mkt_cap_float\"].clip(lower=1e6))\n    debt_ratio = df_copy[\"debttoassets\"] / 100.0\n    health = 1.0 / (1.0 + debt_ratio)\n    factor = cheapness * size_adj * health\n    return factor.rename(\"factor_float_conditioned_book_cheapness_v2\")",
