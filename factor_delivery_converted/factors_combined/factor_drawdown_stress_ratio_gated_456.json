  "code": "def factor_drawdown_stress_ratio_gated(df):\n    df_copy = df.copy()\n    close = df_copy['close']\n    running_max = close.cummax()\n    drawdown = (running_max - close) / running_max\n    drawdown_sum = drawdown.rolling(60, min_periods=60).sum()\n    returns = close.pct_change()\n    vol = returns.rolling(60, min_periods=60).std(ddof=1)\n    raw = drawdown_sum / vol.replace(0.0, np.nan)\n    high_resvol = df_copy['style_gate_resvol_high'] > 0\n    factor_values = np.where(high_resvol, raw * 0.5, raw)\n    factor_values = pd.Series(factor_values, index=df_copy.index)\n    factor_values.name = \"factor_drawdown_stress_ratio_gated\"\n    return factor_values",
