  "code": "def factor_smoothed_downside_variance_resilience(df):\n    \"\"\"Smoothed resilience score from the recent concentration of return variance in losses.\"\"\"\n    df_copy = df.copy()\n    ret = df_copy[\"close\"].pct_change()\n    downside_energy = ret.clip(upper=0.0).pow(2).rolling(20, min_periods=20).sum()\n    total_energy = ret.pow(2).rolling(20, min_periods=20).sum()\n    fragility = downside_energy / total_energy.replace(0.0, np.nan)\n    df_copy[\"factor_smoothed_downside_variance_resilience\"] = -fragility.ewm(span=5, adjust=False, min_periods=5).mean()\n    return df_copy[\"factor_smoothed_downside_variance_resilience\"]",
