  "code": "def factor_drawdown_stress_vol_scaled(df):\n    df_copy = df.copy()\n    close = df_copy[\"close\"]\n    rolling_max = close.rolling(60, min_periods=60).max()\n    in_drawdown = close < rolling_max * 0.95\n    occupancy = in_drawdown.rolling(20, min_periods=20).sum() / 20.0\n    depth = (close / rolling_max) - 1.0\n    stress = -depth * occupancy\n    ret = close.pct_change()\n    vol = ret.rolling(20, min_periods=10).std(ddof=1).replace(0.0, np.nan)\n    vol_attenuation = 1.0 / (1.0 + vol)\n    stress_scaled = stress * vol_attenuation\n    stress_scaled = stress_scaled.fillna(0.0)\n    df_copy[\"factor_drawdown_stress_vol_scaled\"] = stress_scaled\n    return df_copy[\"factor_drawdown_stress_vol_scaled\"]",
