  "code": "def factor_bounded_directional_price_impact_per_volume(df):\n    \"\"\"Bounded and smoothed directional intraday price impact per normalized volume.\"\"\"\n    df_copy = df.copy()\n    body_return = (df_copy[\"close\"] - df_copy[\"open\"]) / df_copy[\"open\"].replace(0.0, np.nan)\n    typical_volume = df_copy[\"volume\"].rolling(20, min_periods=10).median()\n    normalized_volume = df_copy[\"volume\"] / typical_volume.replace(0.0, np.nan)\n    impact_efficiency = body_return / normalized_volume.replace(0.0, np.nan)\n    bounded_impact = impact_efficiency / (1.0 + impact_efficiency.abs())\n    factor = bounded_impact.ewm(span=30, min_periods=18, adjust=False).mean()\n    df_copy[\"factor_bounded_directional_price_impact_per_volume\"] = factor.replace([np.inf, -np.inf], np.nan)\n    return df_copy[\"factor_bounded_directional_price_impact_per_volume\"]",
