  "code": "def factor_trend_cycle_position(df):\n    df_copy = df.copy()\n    close = df_copy[\"close\"]\n    high = df_copy[\"high\"]\n    low = df_copy[\"low\"]\n    # long-term SMA\n    sma200 = close.rolling(200, min_periods=200).mean()\n    # ATR20\n    tr = pd.concat([high - low, (high - close.shift(1)).abs(), (low - close.shift(1)).abs()], axis=1).max(axis=1)\n    atr20 = tr.rolling(20, min_periods=20).mean()\n    # position\n    position = (close - sma200) / atr20.replace(0, np.nan)\n    df_copy[\"factor_trend_cycle_position\"] = position\n    return df_copy[\"factor_trend_cycle_position\"]",
