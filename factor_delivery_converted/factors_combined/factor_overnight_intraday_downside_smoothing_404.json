  "code": "def factor_overnight_intraday_downside_smoothing(df):\n    df_copy = df.copy()\n    overnight_ret, intraday_ret = alpha_tools.decompose_overnight_intraday(df_copy[\"close\"], df_copy[\"open\"])\n    down_overnight = (-overnight_ret.clip(upper=0.0)).rolling(18, min_periods=18).mean()\n    up_intraday = intraday_ret.clip(lower=0.0).rolling(18, min_periods=18).mean()\n    range_ = (df_copy[\"high\"] - df_copy[\"low\"]).rolling(18, min_periods=18).mean()\n    close_vol = df_copy[\"close\"].pct_change().abs().rolling(18, min_periods=18).mean()\n    asym = (down_overnight + 0.5 * close_vol) / (up_intraday + range_ + 1e-12)\n    df_copy[\"factor_overnight_intraday_downside_smoothing\"] = np.log1p(asym)\n    return df_copy[\"factor_overnight_intraday_downside_smoothing\"]",
