  "code": "def factor_overnight_repricing_phase_leadership(df):\n    \"\"\"Identifies long-horizon trends led by overnight repricing rather than intraday reversal.\"\"\"\n    df_copy = df.copy()\n    overnight_ret, intraday_ret = alpha_tools.decompose_overnight_intraday(df_copy[\"close\"], df_copy[\"open\"])\n    overnight_cumulative = overnight_ret.rolling(63, min_periods=63).sum()\n    intraday_cumulative = intraday_ret.rolling(63, min_periods=63).sum()\n    total_activity = (overnight_ret.abs() + intraday_ret.abs()).rolling(63, min_periods=63).sum().replace(0.0, np.nan)\n    phase_leadership = (overnight_cumulative - intraday_cumulative) / total_activity\n    df_copy[\"factor_overnight_repricing_phase_leadership\"] = phase_leadership\n    return df_copy[\"factor_overnight_repricing_phase_leadership\"]",
  "cross_sectional_rationale": "The raw bounded measure is most useful as a same-day relative phase indicator: ranking identifies stocks whose trends are most strongly overnight-repricing-led versus their contemporaries while reducing sensitivity to market-wide changes in the overnight/intraday return mix.",
