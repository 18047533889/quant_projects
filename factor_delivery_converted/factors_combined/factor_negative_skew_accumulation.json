  "code": "def factor_negative_skew_accumulation(df):\n    df_copy = df.copy()\n    returns = np.log(df_copy[\"close\"] / df_copy[\"close\"].shift(1))\n    skew = returns.rolling(20).skew()\n    neg_skew = -skew\n    range_ = (df_copy[\"high\"] - df_copy[\"low\"]) / df_copy[\"close\"]\n    signal = neg_skew * range_\n    factor = signal.ewm(span=10, adjust=False).mean()\n    factor = factor.rename('factor_negative_skew_accumulation')\n    return factor",
