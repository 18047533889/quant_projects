  "code": "def factor_volume_state_persistence(df):\n    df_copy = df.copy()\n    volume = df_copy[\"volume\"]\n    vol_ema = volume.ewm(span=20, adjust=False).mean()\n    vol_above = (volume > vol_ema).astype(float)\n    persistence = vol_above.rolling(20, min_periods=20).sum() / 20.0\n    factor = persistence.fillna(0.5)\n    df_copy[\"factor_volume_state_persistence\"] = factor\n    return df_copy[\"factor_volume_state_persistence\"]",
