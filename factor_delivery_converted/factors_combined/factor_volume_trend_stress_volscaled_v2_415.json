  "code": "def factor_volume_trend_stress_volscaled_v2(df):\n    df_copy = df.copy()\n    close = df_copy['close']\n    volume = df_copy['volume']\n    abs_ret = close.pct_change().abs()\n    is_high_vol, is_low_vol, vol_ratio = alpha_tools.classify_volume_regime(volume, window=20)\n    vol_trend = vol_ratio - 1.0\n    stress = abs_ret * vol_trend\n    stress_accum = stress.rolling(20, min_periods=20).sum()\n    returns = close.pct_change()\n    vol_60 = returns.rolling(60, min_periods=60).std()\n    factor = stress_accum / vol_60.replace(0.0, np.nan)\n    factor = factor.where(np.isfinite(factor), 0.0)\n    factor.name = 'factor_volume_trend_stress_volscaled_v2'\n    return factor",
