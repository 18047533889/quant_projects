  "code": "def factor_size_gated_value_leverage(df):\n    df_copy = df.copy()\n    cheapness_pe = 1.0 / df_copy[\"pe_ttm\"].replace(0, np.nan)\n    cheapness_pb = 1.0 / df_copy[\"pb_lf\"].replace(0, np.nan)\n    leverage_penalty = 1.0 - df_copy[\"debttoassets\"] / 100.0\n    is_large = df_copy[\"style_gate_size_large\"] == 1\n    is_small = df_copy[\"style_gate_size_small\"] == 1\n    factor = cheapness_pe.copy()\n    factor[is_small] = (cheapness_pb * leverage_penalty)[is_small]\n    factor.name = \"factor_size_gated_value_leverage\"\n    return factor",
