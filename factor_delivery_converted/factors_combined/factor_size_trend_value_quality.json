  "code": "def factor_size_trend_value_quality(df):\n    df_copy = df.copy()\n    pe = df_copy[\"pe_ttm\"].replace(0, np.nan)\n    cheapness = 1.0 / pe\n    cheapness = cheapness.where(cheapness > 0, np.nan)\n    size = np.log1p(df_copy[\"mkt_cap_float\"].abs())\n    size_ma = size.rolling(60, min_periods=20).mean()\n    size_dev = (size - size_ma) / size_ma.replace(0, np.nan)\n    roe = df_copy[\"roe_ttm2\"] / 100.0\n    signal = cheapness * (-size_dev) * (1 + roe)\n    signal = signal.replace([np.inf, -np.inf], np.nan)\n    return pd.Series(signal, index=df_copy.index, name=\"factor_size_trend_value_quality\")",
