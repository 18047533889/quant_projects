  "code": "def factor_price_impact_asymmetry(df):\n    df_copy = df.copy()\n    close = df_copy['close']\n    volume = df_copy['volume']\n    ret = close.pct_change()\n    abs_ret = ret.abs()\n    impact = abs_ret / volume.replace(0, np.nan)\n    avg_impact = impact.rolling(20, min_periods=20).mean()\n    vol = ret.rolling(20, min_periods=20).std(ddof=1).replace(0, np.nan)\n    factor = avg_impact / vol\n    pos_ret = ret.where(ret > 0, 0.0)\n    neg_ret = ret.where(ret < 0, 0.0)\n    window = 30\n    vol_up = pos_ret.rolling(window, min_periods=int(window/2)).std(ddof=1)\n    vol_down = neg_ret.rolling(window, min_periods=int(window/2)).std(ddof=1)\n    ratio = vol_down / vol_up.replace(0, np.nan)\n    ratio = ratio.replace([np.inf, -np.inf], np.nan).fillna(0)\n    factor = factor * (1.0 + ratio)\n    factor = factor.replace([np.inf, -np.inf], np.nan).fillna(0)\n    df_copy['factor_price_impact_asymmetry'] = factor\n    return df_copy['factor_price_impact_asymmetry']",
