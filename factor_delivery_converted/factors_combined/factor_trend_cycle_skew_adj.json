  "code": "def factor_trend_cycle_skew_adj(df):\n    df_copy = df.copy()\n    close = df_copy[\"close\"]\n    high = df_copy[\"high\"]\n    low = df_copy[\"low\"]\n    # Primary: trend cycle raw (close - SMA200) / ATR20\n    sma200 = close.rolling(200, min_periods=200).mean()\n    tr = pd.concat([high - low, (high - close.shift(1)).abs(), (low - close.shift(1)).abs()], axis=1).max(axis=1)\n    atr20 = tr.rolling(20, min_periods=20).mean()\n    factor = (close - sma200) / atr20.replace(0, np.nan)\n    # Lightweight modifier: negative skew attenuation\n    returns = np.log(close / close.shift(1))\n    skew20 = returns.rolling(20, min_periods=20).skew()\n    factor = np.where(skew20 < 0, factor * 0.8, factor)\n    df_copy[\"factor_trend_cycle_skew_adj\"] = factor\n    return df_copy[\"factor_trend_cycle_skew_adj\"]",
