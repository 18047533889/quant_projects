  "code": "def factor_smoothed_energy_downside_resilience(df):\n    \"\"\"Resilience from causally smoothed downside and total return energy.\"\"\"\n    df_copy = df.copy()\n    ret = df_copy[\"close\"].pct_change()\n    downside_energy = ret.clip(upper=0.0).pow(2).rolling(20, min_periods=20).sum()\n    total_energy = ret.pow(2).rolling(20, min_periods=20).sum()\n    smooth_downside = downside_energy.ewm(span=5, adjust=False, min_periods=5).mean()\n    smooth_total = total_energy.ewm(span=5, adjust=False, min_periods=5).mean()\n    df_copy[\"factor_smoothed_energy_downside_resilience\"] = -smooth_downside / smooth_total.replace(0.0, np.nan)\n    return df_copy[\"factor_smoothed_energy_downside_resilience\"]",
