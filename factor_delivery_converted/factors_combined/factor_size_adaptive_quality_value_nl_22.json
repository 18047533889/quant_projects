  "code": "def factor_size_adaptive_quality_value_nl(df):\n    df_copy = df.copy()\n    debt_ratio = df_copy[\"debttoassets\"] / 100.0\n    book_yield = 1.0 / df_copy[\"pb_lf\"].replace(0, np.nan)\n    small_value = book_yield * (1.0 / (1.0 + debt_ratio))\n    earnings_yield = 1.0 / df_copy[\"pe_ttm\"].replace(0, np.nan)\n    unlevered_roe = (df_copy[\"roe_ttm2\"] / 100.0) / (1.0 + debt_ratio)\n    large_value = earnings_yield * (1.0 + unlevered_roe)\n    is_small = df_copy[\"style_gate_size_small\"] == 1\n    is_large = df_copy[\"style_gate_size_large\"] == 1\n    signal = large_value.copy()\n    signal[is_small] = small_value[is_small]\n    signal.name = 'factor_size_adaptive_quality_value_nl'\n    return signal",
