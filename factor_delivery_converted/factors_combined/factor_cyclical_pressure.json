  "code": "def factor_cyclical_pressure(df):\n    df_copy = df.copy()\n    high_low = df_copy[\"high\"] - df_copy[\"low\"]\n    high_pc = (df_copy[\"high\"] - df_copy[\"close\"].shift(1)).abs()\n    low_pc = (df_copy[\"low\"] - df_copy[\"close\"].shift(1)).abs()\n    true_range = pd.concat([high_low, high_pc, low_pc], axis=1).max(axis=1)\n    atr_90 = true_range.rolling(90, min_periods=90).mean()\n    atr_change = atr_90 / atr_90.shift(20) - 1\n    return atr_change.fillna(0).rename('factor_cyclical_pressure')",
