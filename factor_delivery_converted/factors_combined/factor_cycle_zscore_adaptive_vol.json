  "code": "def factor_cycle_zscore_adaptive_vol(df):\n    df_copy = df.copy()\n    close = df_copy['close']\n    mean_window = 200\n    vol_window = 20\n    min_periods = 50\n    rolling_mean = close.rolling(mean_window, min_periods=min_periods).mean()\n    rolling_std = close.rolling(vol_window, min_periods=10).std(ddof=1)\n    zscore = (close - rolling_mean) / rolling_std.replace(0.0, np.nan)\n    return zscore.rename(\"factor_cycle_zscore_adaptive_vol\")",
