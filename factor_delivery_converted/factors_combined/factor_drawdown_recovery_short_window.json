  "code": "def factor_drawdown_recovery_short_window(df):\n    df_copy = df.copy()\n    high = df_copy['high']\n    low = df_copy['low']\n    close = df_copy['close']\n    rolling_max = close.rolling(window=60, min_periods=20).max()\n    drawdown = (close - rolling_max) / rolling_max\n    tr = np.maximum(high - low,\n                    np.maximum((high - low.shift(1)).abs(),\n                               (low - high.shift(1)).abs()))\n    atr = tr.rolling(window=20, min_periods=10).mean()\n    normalizer = atr / close\n    normalizer = normalizer.replace(0, np.nan)\n    factor = -drawdown / normalizer\n    factor = factor.fillna(0)\n    factor.name = 'factor_drawdown_recovery_short_window'\n    return factor",
