  "code": "def factor_breakout_distance_volume_confirmed_20d(df):\n    \"\"\"Idea: A close that pierces the prior 20-day high on expanding volume is a volume-confirmed breakout whose distance above the old high measures continuation pressure.\n    Logic: Normalize the breakout distance over the prior 20-day high by ATR and scale by log volume participation, then smooth with a short EMA to reduce single-day noise.\n    Formula: EMA5((close - max(high.shift(1), 20))/ATR * ln(1 + volume/SMA10(volume)))\n    Sub-mechanism tags: range_expansion, volume_confirmation, breakout_momentum, short_smoothing\n    \"\"\"\n    df_copy = df.copy()\n    prior_high = df_copy[\"high\"].shift(1).rolling(20, min_periods=20).max()\n    atr = pd.Series(\n        talib.ATR(\n            df_copy[\"high\"].values.astype(np.float64),\n            df_copy[\"low\"].values.astype(np.float64),\n            df_copy[\"close\"].values.astype(np.float64),\n            timeperiod=14,\n        ),\n        index=df_copy.index,\n    )\n    vol_ma10 = df_copy[\"volume\"].rolling(10, min_periods=10).mean()\n    vol_ratio = df_copy[\"volume\"] / vol_ma10.replace(0.0, np.nan)\n    breakout_dist = (df_copy[\"close\"] - prior_high) / atr.replace(0.0, np.nan)\n    df_copy[\"factor_breakout_distance_volume_confirmed_20d\"] = (\n        (breakout_dist * np.log1p(vol_ratio))\n        .replace([np.inf, -np.inf], np.nan)\n        .ewm(span=5, adjust=False)\n        .mean()\n    )\n    return df_copy[\"factor_breakout_distance_volume_confirmed_20d\"]",
