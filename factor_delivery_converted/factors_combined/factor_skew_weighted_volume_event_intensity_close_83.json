  "code": "def factor_skew_weighted_volume_event_intensity_close(df):\n    df_copy = df.copy()\n    ret = df_copy['close_price'].pct_change().fillna(0.0)\n    med = np.median(ret)\n    mean = np.mean(ret)\n    mad = np.median(np.abs(ret - med))\n    if mad == 0:\n        skew = 0.0\n    else:\n        skew = (mean - med) / mad\n    is_high, volume_z = minute_tools.get_up_space(df_copy['volume'], df_copy['TradingDay'], std_multiplier=1.5)\n    volume_z = volume_z.fillna(0.0)\n    pulse = minute_tools.pulse_start(is_high)\n    intensity = (volume_z * skew).where(pulse > 0).fillna(0.0)\n    value = float(intensity.sum())\n    day = pd.Timestamp(df_copy['TradingDay'].iloc[0])\n    out = pd.Series([value], index=[day], name='factor_skew_weighted_volume_event_intensity_close')\n    return out",
