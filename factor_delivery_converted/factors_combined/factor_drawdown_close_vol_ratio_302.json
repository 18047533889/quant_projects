  "code": "def factor_drawdown_close_vol_ratio(df):\n    df_copy = df.copy()\n    rolling_max = df_copy['close'].rolling(20, min_periods=10).max()\n    max_drawdown_20 = (df_copy['close'] - rolling_max) / rolling_max\n    close_vol = df_copy['close'].rolling(20, min_periods=10).std(ddof=1)\n    stress_ratio = -max_drawdown_20 / close_vol.replace(0.0, np.nan)\n    df_copy['factor_drawdown_close_vol_ratio'] = stress_ratio.fillna(0.0)\n    return df_copy['factor_drawdown_close_vol_ratio']",
