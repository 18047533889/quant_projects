  "code": "def factor_volume_adjusted_price_range_ema(df):\n    df_copy = df.copy()\n    high_low = df_copy['high'] - df_copy['low']\n    volume_ema = df_copy['volume'].ewm(span=10, adjust=False).mean().replace(0, np.nan)\n    volume_ratio = df_copy['volume'] / volume_ema\n    volume_ratio = volume_ratio.replace([np.inf, -np.inf], np.nan).fillna(0)\n    raw_signal = high_low * volume_ratio\n    df_copy[\"factor_volume_adjusted_price_range_ema\"] = raw_signal.ewm(span=10, min_periods=10, adjust=False).mean()\n    return df_copy[\"factor_volume_adjusted_price_range_ema\"]",
