  "code": "def factor_downside_semivariance_resilience_ema8(df):\n    \"\"\"Resilience from smoothed concentration of recent return variance in losses.\"\"\"\n    df_copy = df.copy()\n    ret = df_copy[\"close\"].pct_change()\n    downside_energy = ret.clip(upper=0.0).pow(2).rolling(20, min_periods=20).sum()\n    total_energy = ret.pow(2).rolling(20, min_periods=20).sum()\n    downside_share = downside_energy / total_energy.replace(0.0, np.nan)\n    df_copy[\"factor_downside_semivariance_resilience_ema8\"] = -downside_share.ewm(span=8, adjust=False, min_periods=8).mean()\n    return df_copy[\"factor_downside_semivariance_resilience_ema8\"]",
