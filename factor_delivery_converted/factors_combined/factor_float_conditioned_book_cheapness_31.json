  "code": "def factor_float_conditioned_book_cheapness(df):\n    df_copy = df.copy()\n    # Cheapness: 1 / pb_lf\n    cheapness = 1.0 / df_copy[\"pb_lf\"].replace(0, np.nan)\n    # Float context: smaller free-float implies higher re-rating elasticity\n    float_adj = 1.0 / np.log1p(df_copy[\"free_float_shares\"].clip(lower=1e6))\n    # Health: low debt is positive\n    health = 1.0 - df_copy[\"debttoassets\"] / 100.0\n    # Combine\n    factor = cheapness * float_adj * health\n    return factor.rename(\"factor_float_conditioned_book_cheapness\")",
