  "code": "def factor_cyclical_trend_strength(df):\n    \"\"\"Long-term trend strength using ADX and directional indicators to identify strong cyclical phases.\"\"\"\n    df_copy = df.copy()\n    adx = pd.Series(talib.ADX(df_copy['high'], df_copy['low'], df_copy['close'], timeperiod=50), index=df_copy.index)\n    pdi = pd.Series(talib.PLUS_DI(df_copy['high'], df_copy['low'], df_copy['close'], timeperiod=50), index=df_copy.index)\n    mdi = pd.Series(talib.MINUS_DI(df_copy['high'], df_copy['low'], df_copy['close'], timeperiod=50), index=df_copy.index)\n    trend_strength = np.where(adx > 25, np.where(pdi > mdi, 1.0, -1.0), 0.0)\n    factor = pd.Series(talib.EMA(trend_strength, timeperiod=20), index=df_copy.index)\n    df_copy[\"factor_cyclical_trend_strength\"] = factor\n    return df_copy[\"factor_cyclical_trend_strength\"]",
