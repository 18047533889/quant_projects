  "code": "def factor_price_smoothness_ema(df):\n    df_copy = df.copy()\n    daily_ret = df_copy[\"close\"] / df_copy[\"close\"].shift(1) - 1\n    daily_range = df_copy[\"high\"] - df_copy[\"low\"]\n    smoothness_ratio = (daily_ret ** 2) / (daily_range ** 2).replace(0, np.nan)\n    # Exponential weighted average for more responsive smoothness measure\n    ema_ratio = smoothness_ratio.ewm(span=20, min_periods=10, adjust=False).mean()\n    factor = -ema_ratio\n    df_copy[\"factor_price_smoothness_ema\"] = factor\n    return df_copy[\"factor_price_smoothness_ema\"]",
