# Environment template for Quant Projects
# Copy this file to .env.local and fill in your values

# Environment
ENVIRONMENT=development

# DataAccess service
DATA_ACCESS_API_HOST=0.0.0.0
DATA_ACCESS_API_PORT=8765
DATA_ACCESS_LOG_LEVEL=INFO
DATA_ACCESS_ENABLE_METRICS=true
DUCKDB_TEMP_DIRECTORY=/tmp/duckdb
DUCKDB_MAX_MEMORY=4GB
DUCKDB_THREADS=4

# FactorEngine service
FACTOR_ENGINE_SERVICE_PORT=8766
FACTOR_ENGINE_LOG_LEVEL=INFO
FACTOR_ENGINE_ENABLE_METRICS=true
FACTOR_ENGINE_CACHE_SIZE=2GB
FACTOR_ENGINE_MAX_WORKERS=8

# Service URLs
DATA_ACCESS_API_URL=http://localhost:8765
FACTOR_ENGINE_API_URL=http://localhost:8766

# Database (if used)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=quant_db
DATABASE_USER=quant_user
DATABASE_PASSWORD=CHANGE_ME
DATABASE_POOL_SIZE=10

# Redis (if used)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Object Storage (COS/S3)
COS_ENDPOINT=https://cos.example.com
COS_BUCKET=quant-bucket
COS_ACCESS_KEY=CHANGE_ME
COS_SECRET_KEY=CHANGE_ME
COS_REGION=us-east-1

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Feature flags
ENABLE_EXPERIMENTAL_FEATURES=false
ENABLE_DEBUG_ENDPOINTS=false
