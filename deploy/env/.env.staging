# Staging environment configuration
ENVIRONMENT=staging

# DataAccess service
DATA_ACCESS_API_HOST=0.0.0.0
DATA_ACCESS_API_PORT=8765
DATA_ACCESS_LOG_LEVEL=INFO
DATA_ACCESS_ENABLE_METRICS=true
DUCKDB_TEMP_DIRECTORY=/tmp/duckdb
DUCKDB_MAX_MEMORY=8GB
DUCKDB_THREADS=8

# FactorEngine service
FACTOR_ENGINE_SERVICE_PORT=8766
FACTOR_ENGINE_LOG_LEVEL=INFO
FACTOR_ENGINE_ENABLE_METRICS=true
FACTOR_ENGINE_CACHE_SIZE=4GB
FACTOR_ENGINE_MAX_WORKERS=16

# Service URLs
DATA_ACCESS_API_URL=http://dataaccess:8765
FACTOR_ENGINE_API_URL=http://factorengine:8766

# Database (if used)
DATABASE_HOST=postgres-staging.example.com
DATABASE_PORT=5432
DATABASE_NAME=quant_staging
DATABASE_USER=quant_user
DATABASE_PASSWORD=${DATABASE_PASSWORD_SECRET}
DATABASE_POOL_SIZE=20
DATABASE_SSL_MODE=require

# Redis (if used)
REDIS_HOST=redis-staging.example.com
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=${REDIS_PASSWORD_SECRET}
REDIS_SSL=true

# Object Storage (COS/S3)
COS_ENDPOINT=https://cos.example.com
COS_BUCKET=quant-staging
COS_ACCESS_KEY=${COS_ACCESS_KEY_SECRET}
COS_SECRET_KEY=${COS_SECRET_KEY_SECRET}
COS_REGION=us-east-1

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Performance tuning
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=300
CONNECTION_POOL_SIZE=50

# Feature flags
ENABLE_EXPERIMENTAL_FEATURES=true
ENABLE_DEBUG_ENDPOINTS=false
