# Production environment configuration
ENVIRONMENT=production

# DataAccess service
DATA_ACCESS_API_HOST=0.0.0.0
DATA_ACCESS_API_PORT=8765
DATA_ACCESS_LOG_LEVEL=WARNING
DATA_ACCESS_ENABLE_METRICS=true
DUCKDB_TEMP_DIRECTORY=/tmp/duckdb
DUCKDB_MAX_MEMORY=16GB
DUCKDB_THREADS=16

# FactorEngine service
FACTOR_ENGINE_SERVICE_PORT=8766
FACTOR_ENGINE_LOG_LEVEL=WARNING
FACTOR_ENGINE_ENABLE_METRICS=true
FACTOR_ENGINE_CACHE_SIZE=8GB
FACTOR_ENGINE_MAX_WORKERS=32

# Service URLs
DATA_ACCESS_API_URL=http://dataaccess:8765
FACTOR_ENGINE_API_URL=http://factorengine:8766

# Database (if used)
DATABASE_HOST=postgres-production.example.com
DATABASE_PORT=5432
DATABASE_NAME=quant_production
DATABASE_USER=quant_user
DATABASE_PASSWORD=${DATABASE_PASSWORD_SECRET}
DATABASE_POOL_SIZE=50
DATABASE_SSL_MODE=require
DATABASE_CONNECTION_TIMEOUT=10

# Redis (if used)
REDIS_HOST=redis-production.example.com
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=${REDIS_PASSWORD_SECRET}
REDIS_SSL=true
REDIS_CONNECTION_POOL_SIZE=50

# Object Storage (COS/S3)
COS_ENDPOINT=https://cos.example.com
COS_BUCKET=quant-production
COS_ACCESS_KEY=${COS_ACCESS_KEY_SECRET}
COS_SECRET_KEY=${COS_SECRET_KEY_SECRET}
COS_REGION=us-east-1
COS_USE_SSL=true

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALERTMANAGER_URL=http://alertmanager:9093

# Performance tuning
MAX_CONCURRENT_REQUESTS=500
REQUEST_TIMEOUT=600
CONNECTION_POOL_SIZE=100
KEEP_ALIVE_TIMEOUT=65

# Security
CORS_ORIGINS=https://app.example.com,https://admin.example.com
RATE_LIMIT_PER_MINUTE=1000
ENABLE_API_KEY_AUTH=true

# Feature flags
ENABLE_EXPERIMENTAL_FEATURES=false
ENABLE_DEBUG_ENDPOINTS=false

# Alerting
ALERT_EMAIL=alerts@example.com
ALERT_SLACK_WEBHOOK=${SLACK_WEBHOOK_SECRET}
