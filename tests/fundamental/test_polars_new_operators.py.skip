# -*- coding: utf-8 -*-
"""Parity tests for new Polars fundamental operators.

Tests the 19 new operators added for extended financial analysis:
- Financial ratios: fin_delta, fin_yoy_growth, fin_rolling_mean, fin_rolling_std, fin_ma, fin_ema, fin_rank, fin_percentile
- Fundamental statistics: fin_consistency, fin_trend, fin_acceleration, fin_volatility, fin_quality_score, fin_growth_score, fin_value_score, fin_momentum_score
- Period operations: fin_trailing_sum, fin_seasonal_diff, fin_same_quarter_yoy, fin_period_rank
"""
import numpy as np
import polars as pl
import pytest

from cleaned_operators.fundamental.polars_fundamental import (
    fin_acceleration,
    fin_consistency,
    fin_delta,
    fin_ema,
    fin_growth_score,
    fin_ma,
    fin_momentum_score,
    fin_period_rank,
    fin_percentile,
    fin_quality_score,
    fin_rank,
    fin_rolling_mean,
    fin_rolling_std,
    fin_same_quarter_yoy,
    fin_seasonal_diff,
    fin_trailing_sum,
    fin_trend,
    fin_value_score,
    fin_volatility,
    fin_yoy_growth,
)


@pytest.fixture
def simple_panel():
    """Simple panel with 3 stocks, 8 periods."""
    dates = ["2023-01-01", "2023-04-01", "2023-07-01", "2023-10-01",
             "2024-01-01", "2024-04-01", "2024-07-01", "2024-10-01"]
    data = []
    for stock in ["A", "B", "C"]:
        for i, date in enumerate(dates):
            data.append({
                "date": date,
                "stock_code": stock,
                "value": 100.0 + i * 10.0 + (ord(stock) - ord("A")) * 5.0,
            })

    df = pl.DataFrame(data)

    period_data = []
    for stock in ["A", "B", "C"]:
        for i, date in enumerate(dates):
            period_data.append({
                "date": date,
                "stock_code": stock,
                "value": f"2023Q{(i % 4) + 1}" if i < 4 else f"2024Q{(i % 4) + 1}",
            })

    period_df = pl.DataFrame(period_data)

    quarter_data = []
    for stock in ["A", "B", "C"]:
        for i, date in enumerate(dates):
            quarter_data.append({
                "date": date,
                "stock_code": stock,
                "value": (i % 4) + 1,
            })

    quarter_df = pl.DataFrame(quarter_data)

    return df, period_df, quarter_df


def test_fin_delta(simple_panel):
    """Test fin_delta (alias for fin_diff)."""
    df, period_df, _ = simple_panel
    result = fin_delta(df, period_df, periods=1)

    assert isinstance(result, pl.DataFrame)
    assert "value" in result.columns
    # First period should be NaN (no prior period)
    first_values = result.filter(pl.col("date") == "2023-01-01")["value"].to_list()
    assert all(np.isnan(v) for v in first_values)

    # Second period should show delta of 10.0
    second_values = result.filter(pl.col("date") == "2023-04-01")["value"].to_list()
    assert all(abs(v - 10.0) < 0.01 for v in second_values if np.isfinite(v))


def test_fin_yoy_growth(simple_panel):
    """Test fin_yoy_growth (4-period percent change)."""
    df, period_df, _ = simple_panel
    result = fin_yoy_growth(df, period_df, periods_per_year=4, flow_type=None)

    assert isinstance(result, pl.DataFrame)
    # First 4 periods should be NaN
    first_four = result.filter(pl.col("date").is_in(
        ["2023-01-01", "2023-04-01", "2023-07-01", "2023-10-01"]
    ))
    assert all(np.isnan(v) for v in first_four["value"].to_list())

    # 5th period (2024-01-01) should have YoY growth
    fifth_values = result.filter(pl.col("date") == "2024-01-01")["value"].to_list()
    assert all(np.isfinite(v) for v in fifth_values)


def test_fin_rolling_mean(simple_panel):
    """Test fin_rolling_mean over 4 periods."""
    df, period_df, _ = simple_panel
    result = fin_rolling_mean(df, period_df, periods=4)

    assert isinstance(result, pl.DataFrame)
    # First 3 periods should be NaN (need 4 periods)
    early = result.filter(pl.col("date").is_in(
        ["2023-01-01", "2023-04-01", "2023-07-01"]
    ))
    assert all(np.isnan(v) for v in early["value"].to_list())

    # 4th period should have mean of first 4 values
    fourth = result.filter(pl.col("date") == "2023-10-01")
    assert all(np.isfinite(v) for v in fourth["value"].to_list())


def test_fin_ma_alias(simple_panel):
    """Test fin_ma is alias for fin_rolling_mean."""
    df, period_df, _ = simple_panel
    result_ma = fin_ma(df, period_df, periods=4)
    result_mean = fin_rolling_mean(df, period_df, periods=4)

    # Should produce identical results
    assert result_ma["value"].to_list() == result_mean["value"].to_list()


def test_fin_ema(simple_panel):
    """Test exponential moving average."""
    df, period_df, _ = simple_panel
    result = fin_ema(df, period_df, periods=4)

    assert isinstance(result, pl.DataFrame)
    # All periods should have values (EMA initializes with first value)
    assert all(np.isfinite(v) for v in result["value"].to_list())


def test_fin_rank(simple_panel):
    """Test fin_rank (1=lowest)."""
    df, period_df, _ = simple_panel
    result = fin_rank(df, period_df, periods=4)

    assert isinstance(result, pl.DataFrame)
    # Ranks should be in range [1, 4] for 4-period window
    valid_values = [v for v in result["value"].to_list() if np.isfinite(v)]
    assert all(1.0 <= v <= 4.0 for v in valid_values)


def test_fin_percentile(simple_panel):
    """Test fin_percentile (alias for fin_percentile_history)."""
    df, period_df, _ = simple_panel
    result = fin_percentile(df, period_df, periods=4)

    assert isinstance(result, pl.DataFrame)
    # Percentiles should be in [0, 1]
    valid_values = [v for v in result["value"].to_list() if np.isfinite(v)]
    assert all(0.0 <= v <= 1.0 for v in valid_values)


def test_fin_consistency(simple_panel):
    """Test fin_consistency (inverse CV)."""
    df, period_df, _ = simple_panel
    result = fin_consistency(df, period_df, periods=4)

    assert isinstance(result, pl.DataFrame)
    # Consistency should be in [0, 1]
    valid_values = [v for v in result["value"].to_list() if np.isfinite(v)]
    assert all(0.0 <= v <= 1.0 for v in valid_values)


def test_fin_trend_alias(simple_panel):
    """Test fin_trend is alias for fin_trend_slope."""
    df, period_df, _ = simple_panel
    result = fin_trend(df, period_df, periods=4)

    assert isinstance(result, pl.DataFrame)
    # Trend should exist for upward trending data
    valid_values = [v for v in result["value"].to_list() if np.isfinite(v)]
    # All values should be positive (data is monotonically increasing)
    assert all(v > 0 for v in valid_values)


def test_fin_acceleration(simple_panel):
    """Test fin_acceleration (growth difference)."""
    df, period_df, _ = simple_panel
    result = fin_acceleration(df, period_df, short_periods=1, long_periods=2)

    assert isinstance(result, pl.DataFrame)
    # Should have finite values after enough periods
    all_values = result["value"].to_list()
    assert any(np.isfinite(v) for v in all_values)


def test_fin_volatility_alias(simple_panel):
    """Test fin_volatility is alias for fin_std."""
    df, period_df, _ = simple_panel
    result = fin_volatility(df, period_df, periods=4)

    assert isinstance(result, pl.DataFrame)
    valid_values = [v for v in result["value"].to_list() if np.isfinite(v)]
