    assert all(v >= 0 for v in valid_values)


def test_fin_quality_score(simple_panel):
    """Test fin_quality_score (consistency + trend strength)."""
    df, period_df, _ = simple_panel
    result = fin_quality_score(df, period_df, periods=4)

    assert isinstance(result, pl.DataFrame)
    valid_values = [v for v in result["value"].to_list() if np.isfinite(v)]
    # Quality score should be roughly in [0, 1] range
    assert all(0.0 <= v <= 1.5 for v in valid_values)  # Allow some overshoot


def test_fin_growth_score(simple_panel):
    """Test fin_growth_score (growth × stability)."""
    df, period_df, _ = simple_panel
    result = fin_growth_score(df, period_df, growth_periods=1, stability_periods=4)

    assert isinstance(result, pl.DataFrame)
    # Should have finite values
    all_values = result["value"].to_list()
    assert any(np.isfinite(v) for v in all_values)


def test_fin_value_score(simple_panel):
    """Test fin_value_score (inverted z-score)."""
    df, period_df, _ = simple_panel
    benchmark = df  # Use same as benchmark for simplicity
    result = fin_value_score(df, benchmark, period_df, periods=4)

    assert isinstance(result, pl.DataFrame)
    # Value score can be any real number
    all_values = result["value"].to_list()
    assert any(np.isfinite(v) for v in all_values)


def test_fin_momentum_score(simple_panel):
    """Test fin_momentum_score (trend + acceleration)."""
    df, period_df, _ = simple_panel
    result = fin_momentum_score(df, period_df, short_periods=2, long_periods=4)

    assert isinstance(result, pl.DataFrame)
    valid_values = [v for v in result["value"].to_list() if np.isfinite(v)]
    # Momentum should be positive for upward trending data
    assert len(valid_values) > 0


def test_fin_trailing_sum(simple_panel):
    """Test fin_trailing_sum (sum over periods)."""
    df, period_df, _ = simple_panel
    result = fin_trailing_sum(df, period_df, periods=4)

    assert isinstance(result, pl.DataFrame)
    # Sum should be larger than any individual value
    valid_values = [v for v in result["value"].to_list() if np.isfinite(v)]
    assert all(v > 100.0 for v in valid_values)  # All individual values >= 100


def test_fin_seasonal_diff(simple_panel):
    """Test fin_seasonal_diff (same quarter difference)."""
    df, period_df, quarter_df = simple_panel
    result = fin_seasonal_diff(df, period_df, quarter_df, seasons_back=4)

    assert isinstance(result, pl.DataFrame)
    # Should have some finite values after 4 seasons
    all_values = result["value"].to_list()
    finite_count = sum(1 for v in all_values if np.isfinite(v))
    assert finite_count > 0


def test_fin_same_quarter_yoy(simple_panel):
    """Test fin_same_quarter_yoy (YoY for same quarter)."""
    df, period_df, quarter_df = simple_panel
    result = fin_same_quarter_yoy(df, period_df, quarter_df, flow_type=None)

    assert isinstance(result, pl.DataFrame)
    # Should have some finite values
    all_values = result["value"].to_list()
    finite_count = sum(1 for v in all_values if np.isfinite(v))
    assert finite_count > 0


def test_fin_period_rank(simple_panel):
    """Test fin_period_rank (normalized rank [0,1])."""
    df, period_df, _ = simple_panel
    result = fin_period_rank(df, period_df, periods=4)

    assert isinstance(result, pl.DataFrame)
    # Normalized ranks should be in [0, 1]
    valid_values = [v for v in result["value"].to_list() if np.isfinite(v)]
    assert all(0.0 <= v <= 1.0 for v in valid_values)


def test_pit_semantics_no_lookahead():
    """Test that operators maintain PIT semantics (no lookahead)."""
    # Create data where future values are dramatically different
    df = pl.DataFrame({
        "date": ["2023-Q1", "2023-Q2", "2023-Q3", "2023-Q4"],
        "stock_code": ["A"] * 4,
        "value": [100.0, 105.0, 110.0, 1000.0],  # Big jump at end
    })

    period_df = pl.DataFrame({
        "date": ["2023-Q1", "2023-Q2", "2023-Q3", "2023-Q4"],
        "stock_code": ["A"] * 4,
        "value": ["2023Q1", "2023Q2", "2023Q3", "2023Q4"],
    })

    # Calculate rolling mean at Q3 (should not see Q4's 1000)
    result = fin_rolling_mean(df, period_df, periods=3)
    q3_mean = result.filter(pl.col("date") == "2023-Q3")["value"].to_list()[0]

    # Expected mean: (100 + 105 + 110) / 3 = 105
    assert abs(q3_mean - 105.0) < 0.01


def test_revision_handling():
    """Test that operators handle period revisions correctly."""
    # Same period appearing twice (revision)
    df = pl.DataFrame({
        "date": ["2023-01", "2023-02", "2023-03"],
        "stock_code": ["A"] * 3,
        "value": [100.0, 105.0, 107.0],  # Q1 revised from 105 to 107
    })

    period_df = pl.DataFrame({
        "date": ["2023-01", "2023-02", "2023-03"],
        "stock_code": ["A"] * 3,
        "value": ["2023Q1", "2023Q1", "2023Q2"],  # Q1 appears twice (revision)
    })

    # Operators should handle revisions gracefully
    result = fin_delta(df, period_df, periods=1)

    # Should not crash and produce valid structure
    assert isinstance(result, pl.DataFrame)
    assert len(result) == 3
