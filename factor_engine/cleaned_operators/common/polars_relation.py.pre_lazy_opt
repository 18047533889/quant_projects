    business_category="relation",
    canonical="relation_distinct_count",
    source=_SRC,
    backend="polars",
)
class RelationDistinctCountNative(SeriesOperator):
    """Count of distinct non-null values."""

    metadata = OperatorMetadata(
        name="relation_distinct_count",
        category="relation",
        description="不同值计数",
        param_names=["x"],
        return_type="series",
        tags=["relation", "polars", "native"],
    )

    def _calculate_series(self, x: pl.DataFrame, **kwargs) -> pl.DataFrame:
        def _xform(long: pl.DataFrame) -> pl.DataFrame:
            cnt = pl.col("_v").n_unique().over("_r").cast(pl.Float64)
            return long.with_columns(cnt.alias("_v"))

        return _cs_long_transform(x, _xform)


