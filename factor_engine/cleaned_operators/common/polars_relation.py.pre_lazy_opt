@register_operator(
    name="relation_entropy",
    category="relation",
    business_category="relation",
    canonical="relation_entropy",
    source=_SRC,
    backend="polars",
)
class RelationEntropyNative(SeriesOperator):
    """Shannon entropy of the cross-sectional distribution."""

    metadata = OperatorMetadata(
        name="relation_entropy",
        category="relation",
        description="截面熵",
        param_names=["x"],
        return_type="series",
        tags=["relation", "polars", "native"],
    )

    def _calculate_series(self, x: pl.DataFrame, **kwargs) -> pl.DataFrame:
        def _xform(long: pl.DataFrame) -> pl.DataFrame:
            total = pl.col("_v").sum().over("_r")
            p = pl.col("_v") / total
            # -sum(p * log(p)), skip zeros
            entropy = pl.when(p > 0).then(-p * p.log()).otherwise(0.0).sum().over("_r")
            return long.with_columns(entropy.alias("_v"))

        return _cs_long_transform(x, _xform)


