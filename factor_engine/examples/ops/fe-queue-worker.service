[Unit]
Description=Factor Engine queue worker
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/quant_projects/factor_engine
Environment=PYTHONPATH=/opt/quant_projects:/opt/quant_projects/factor_engine
ExecStart=/usr/bin/python3 run_pipeline.py queue worker \
  --queue-root /var/lib/factor_engine/queue \
  --queue-max-retries 2 \
  --poll-interval 5 \
  --recover-stale \
  --profile prod \
  --strict-dq
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
