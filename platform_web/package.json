{
  "name": "platform-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Quant Research Platform Web UI (spec §25/§26/§49) — React + TypeScript + Vite. Builds in CI (this env has no node).",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
