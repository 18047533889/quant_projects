{
  "title": "Factor Engine Pipeline",
  "uid": "factor-engine-pipeline",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": ["factor_engine", "quant"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Configs Success",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "factor_engine_configs_success",
          "legendFormat": "success"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Configs Failed",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [
        {
          "expr": "factor_engine_configs_failed",
          "legendFormat": "failed"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Materialized Rows",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "factor_engine_total_materialized_rows",
          "legendFormat": "rows"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Data Access Queries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {
          "expr": "factor_engine_data_access_queries_total",
          "legendFormat": "{{operator}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Config Rows Written",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {
          "expr": "factor_engine_config_rows_written",
          "legendFormat": "{{config_name}} {{status}}"
        }
      ]
    }
  ],
  "templating": {"list": []},
  "annotations": {"list": []}
}
