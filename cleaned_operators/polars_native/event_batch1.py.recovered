@register_operator(name="event_log_return_sum", canonical="event_log_return_sum", backend="polars")
class EventLogReturnSumPolarsNative(SeriesOperator):
    """Sum of log returns at event times"""
    metadata = OperatorMetadata(
        name="event_log_return_sum",
        category="event",
        description="Sum of log returns at event times",
        param_names=["returns", "event_flag", "window"],
        return_type="series",
        tags=["event", "polars_native"],
    )

    def _calculate_series(self, returns, event_flag, window=20, **kwargs):
        df = pl.from_pandas(pd.concat([returns.to_frame(), event_flag.to_frame().rename(columns={event_flag.name: "_event"})], axis=1))

        return (
            df
            .lazy()
            .with_columns([
                pl.when(pl.col("_event") > 0)
                .then((1.0 + pl.col(returns.name)).log())
                .otherwise(0.0)
                .alias("_event_log_ret")
            ])
            .select([
                pl.col("_event_log_ret")
                .rolling_sum(window_size=window, min_periods=1)
                .alias(returns.name)
            ])
            .collect()
            .to_series()
        )


# ============================================================================
# Advanced Event Metrics
# ============================================================================

@register_operator(name="event_response_effective_events", canonical="event_response_effective_events", backend="polars")
class EventResponseEffectiveEventsPolarsNative(SeriesOperator):
    """Shannon entropy-based effective number of events contributing to response"""
    metadata = OperatorMetadata(
        name="event_response_effective_events",
        category="event",
        description="Shannon entropy-based effective number of events contributing to response",
        param_names=["event_flag", "window"],
        return_type="series",
        tags=["event", "polars_native"],
    )

    def _calculate_series(self, event_flag, window=20, **kwargs):
        # Simplified: diversity measure of event distribution
        return (
            pl.from_pandas(event_flag.to_frame()).lazy()
            .with_columns([
                pl.col(event_flag.name).rolling_sum(window_size=window, min_periods=1).alias("_count"),
                pl.col(event_flag.name).rolling_mean(window_size=window, min_periods=1).alias("_mean")
            ])
            .select([
                (pl.col("_count") * pl.col("_mean") / (pl.col("_mean") + 1e-8))
                .alias(event_flag.name)
            ])
            .collect()
            .to_series()
        )


@register_operator(name="event_response_overlap_ratio", canonical="event_response_overlap_ratio", backend="polars")
class EventResponseOverlapRatioPolarsNative(SeriesOperator):
    """Ratio of time when multiple event response windows overlap"""
    metadata = OperatorMetadata(
        name="event_response_overlap_ratio",
        category="event",
        description="Ratio of time when multiple event response windows overlap",
        param_names=["event_flag", "response_window", "lookback"],
        return_type="series",
        tags=["event", "polars_native"],
    )

    def _calculate_series(self, event_flag, response_window=10, lookback=50, **kwargs):
        return (
            pl.from_pandas(event_flag.to_frame()).lazy()
            .with_columns([
                pl.col(event_flag.name)
                .rolling_sum(window_size=response_window, min_periods=1)
                .alias("_active_events")
            ])
            .with_columns([
                pl.when(pl.col("_active_events") > 1).then(1.0).otherwise(0.0).alias("_overlap")
            ])
            .select([
                pl.col("_overlap")
                .rolling_mean(window_size=lookback, min_periods=1)
                .alias(event_flag.name)
            ])
            .collect()
            .to_series()
        )


@register_operator(name="event_response_decay_rate", canonical="event_response_decay_rate", backend="polars")
class EventResponseDecayRatePolarsNative(SeriesOperator):
    """Estimated decay rate of event impact over time"""
    metadata = OperatorMetadata(
        name="event_response_decay_rate",
        category="event",
        description="Estimated decay rate of event impact over time",
        param_names=["returns", "event_flag", "window"],
        return_type="series",
        tags=["event", "polars_native"],
    )

    def _calculate_series(self, returns, event_flag, window=20, **kwargs):
        df = pl.from_pandas(pd.concat([returns.to_frame(), event_flag.to_frame().rename(columns={event_flag.name: "_event"})], axis=1))

        # Simplified: compare near vs far event impacts
        return (
            df
            .lazy()
            .with_columns([
                pl.when(pl.col("_event") > 0)
                .then(pl.col(returns.name))
                .otherwise(0.0)
                .alias("_event_ret")
            ])
            .with_columns([
                pl.col("_event_ret").rolling_mean(window_size=window//2, min_periods=1).alias("_near"),
                pl.col("_event_ret").rolling_mean(window_size=window, min_periods=1).alias("_far")
            ])
            .select([
                ((pl.col("_near") - pl.col("_far")) / (pl.col("_near") + 1e-8))
                .alias(returns.name)
            ])
            .collect()
            .to_series()
        )


@register_operator(name="event_cluster_mean_size", canonical="event_cluster_mean_size", backend="polars")
class EventClusterMeanSizePolarsNative(SeriesOperator):
    """Average number of events per cluster"""
    metadata = OperatorMetadata(
        name="event_cluster_mean_size",
        category="event",
        description="Average number of events per cluster",
        param_names=["event_flag", "window", "min_gap"],
        return_type="series",
        tags=["event", "polars_native"],
    )

    def _calculate_series(self, event_flag, window=20, min_gap=3, **kwargs):
        df = pl.from_pandas(event_flag.to_frame()).with_row_count("_idx")

        return (
            df
            .lazy()
            .with_columns([
                pl.when(pl.col(event_flag.name) > 0)
                .then(pl.col("_idx"))
                .otherwise(None)
                .alias("_event_idx")
            ])
            .with_columns([
                (pl.col("_event_idx") - pl.col("_event_idx").shift(1))
                .alias("_gap")
            ])
            .with_columns([
                pl.when(pl.col("_gap").is_null() | (pl.col("_gap") > min_gap))
                .then(1.0)
                .otherwise(0.0)
                .alias("_new_cluster")
            ])
            .with_columns([
                pl.col(event_flag.name).rolling_sum(window_size=window, min_periods=1).alias("_total_events"),
                pl.col("_new_cluster").rolling_sum(window_size=window, min_periods=1).alias("_clusters")
            ])
            .select([
                (pl.col("_total_events") / (pl.col("_clusters") + 1e-8))
                .alias(event_flag.name)
            ])
            .collect()
            .to_series()
        )


@register_operator(name="event_level_survival_share", canonical="event_level_survival_share", backend="polars")
class EventLevelSurvivalSharePolarsNative(SeriesOperator):
    """Share of events where price level survived (didn't reverse) after window"""
    metadata = OperatorMetadata(
        name="event_level_survival_share",
        category="event",
        description="Share of events where price level survived (didn't reverse) after window",
        param_names=["returns", "event_flag", "survival_window", "lookback"],
        return_type="series",
        tags=["event", "polars_native"],
    )

    def _calculate_series(self, returns, event_flag, survival_window=10, lookback=50, **kwargs):
        df = pl.from_pandas(pd.concat([returns.to_frame(), event_flag.to_frame().rename(columns={event_flag.name: "_event"})], axis=1))

        return (
            df
            .lazy()
            .with_columns([
                pl.col(returns.name).shift(-survival_window).alias("_future_ret")
            ])
            .with_columns([
                pl.when(pl.col("_event") > 0)
                .then(
                    pl.when((pl.col(returns.name) * pl.col("_future_ret")) > 0)
                    .then(1.0)
                    .otherwise(0.0)
                )
                .otherwise(None)
                .alias("_survival")
            ])
            .select([
                pl.col("_survival")
                .rolling_mean(window_size=lookback, min_periods=1)
                .alias(returns.name)
            ])
            .collect()
            .to_series()
        )


@register_operator(name="event_mark_autocorr", canonical="event_mark_autocorr", backend="polars")
class EventMarkAutocorrPolarsNative(SeriesOperator):
    """Autocorrelation of event marks (e.g., returns at event times)"""
    metadata = OperatorMetadata(
        name="event_mark_autocorr",
        category="event",
        description="Autocorrelation of event marks (e.g., returns at event times)",
        param_names=["returns", "event_flag", "lookback", "lag"],
        return_type="series",
        tags=["event", "polars_native"],
    )

    def _calculate_series(self, returns, event_flag, lookback=50, lag=1, **kwargs):
        df = pl.from_pandas(pd.concat([returns.to_frame(), event_flag.to_frame().rename(columns={event_flag.name: "_event"})], axis=1))

        return (
            df
            .lazy()
            .with_columns([
                pl.when(pl.col("_event") > 0)
                .then(pl.col(returns.name))
                .otherwise(None)
                .alias("_mark")
            ])
            .with_columns([
                pl.col("_mark").shift(lag).alias("_mark_lag")
            ])
            .with_columns([
                (pl.col("_mark") * pl.col("_mark_lag")).alias("_product")
            ])
            .select([
                pl.col("_product")
                .rolling_mean(window_size=lookback, min_periods=1)
                .alias(returns.name)
            ])
            .collect()
            .to_series()
        )


@register_operator(name="event_interval_mark_coupling", canonical="event_interval_mark_coupling", backend="polars")
class EventIntervalMarkCouplingPolarsNative(SeriesOperator):
    """Correlation between inter-event intervals and event marks"""
    metadata = OperatorMetadata(
        name="event_interval_mark_coupling",
        category="event",
        description="Correlation between inter-event intervals and event marks",
        param_names=["returns", "event_flag", "lookback"],
        return_type="series",
        tags=["event", "polars_native"],
    )

    def _calculate_series(self, returns, event_flag, lookback=50, **kwargs):
        df = pl.from_pandas(returns.to_frame()).with_columns([
            pl.from_pandas(event_flag.to_frame()).select(pl.col(event_flag.name).alias("_event")).to_series()
        ]).with_row_count("_idx")

        return (
            df
            .lazy()
            .with_columns([
                pl.when(pl.col("_event") > 0)
                .then(pl.col("_idx"))
                .otherwise(None)
                .alias("_event_idx")
            ])
            .with_columns([
                (pl.col("_event_idx") - pl.col("_event_idx").shift(1)).alias("_interval"),
                pl.when(pl.col("_event") > 0)
                .then(pl.col(returns.name))
                .otherwise(None)
                .alias("_mark")
            ])
            .with_columns([
                (pl.col("_interval") * pl.col("_mark")).alias("_product"),
                pl.col("_interval").alias("_int_sq"),
                pl.col("_mark").alias("_mark_sq")
            ])
            .select([
                (pl.col("_product").rolling_mean(window_size=lookback, min_periods=1) /
                 ((pl.col("_int_sq").rolling_std(window_size=lookback, min_periods=2) *
                   pl.col("_mark_sq").rolling_std(window_size=lookback, min_periods=2)) + 1e-8))
                .alias(returns.name)
            ])
            .collect()
            .to_series()
        )


@register_operator(name="event_hawkes_branching_ratio_proxy", canonical="event_hawkes_branching_ratio_proxy", backend="polars")
class EventHawkesBranchingRatioProxyPolarsNative(SeriesOperator):
    """Proxy for Hawkes process branching ratio (self-excitement measure)"""
    metadata = OperatorMetadata(
        name="event_hawkes_branching_ratio_proxy",
        category="event",
        description="Proxy for Hawkes process branching ratio (self-excitement measure)",
        param_names=["event_flag", "window", "decay_window"],
        return_type="series",
        tags=["event", "polars_native"],
    )

    def _calculate_series(self, event_flag, window=50, decay_window=10, **kwargs):
        # Simplified: ratio of observed to baseline event rate after events
        return (
            pl.from_pandas(event_flag.to_frame()).lazy()
            .with_columns([
                pl.col(event_flag.name).rolling_mean(window_size=window, min_periods=1).alias("_baseline"),
                pl.col(event_flag.name).rolling_mean(window_size=decay_window, min_periods=1).alias("_recent")
            ])
            .select([
                ((pl.col("_recent") - pl.col("_baseline")) / (pl.col("_baseline") + 1e-8))
                .alias(event_flag.name)
            ])
            .collect()
            .to_series()
        )


@register_operator(name="event_allan_scaling_slope", canonical="event_allan_scaling_slope", backend="polars")
class EventAllanScalingSlopePolarsNative(SeriesOperator):
    """Slope of Allan factor across scales (power law exponent)"""
    metadata = OperatorMetadata(
        name="event_allan_scaling_slope",
        category="event",
        description="Slope of Allan factor across scales (power law exponent)",
        param_names=["event_flag", "window"],
        return_type="series",
        tags=["event", "polars_native"],
    )

    def _calculate_series(self, event_flag, window=50, **kwargs):
        # Simplified: compare Allan factor at different scales
        return (
            pl.from_pandas(event_flag.to_frame()).lazy()
            .with_columns([
                pl.col(event_flag.name).rolling_sum(window_size=5, min_periods=1).alias("_w5"),
                pl.col(event_flag.name).rolling_sum(window_size=20, min_periods=1).alias("_w20")
            ])
            .with_columns([
                pl.col("_w5").rolling_var(window_size=window//4, min_periods=2).alias("_var5"),
                pl.col("_w20").rolling_var(window_size=window//4, min_periods=2).alias("_var20"),
                pl.col("_w5").rolling_mean(window_size=window//4, min_periods=1).alias("_mean5"),
                pl.col("_w20").rolling_mean(window_size=window//4, min_periods=1).alias("_mean20")
            ])
            .select([
                (((pl.col("_var20") / (pl.col("_mean20") + 1e-8)).log() -
                  (pl.col("_var5") / (pl.col("_mean5") + 1e-8)).log()) /
                 (np.log(20) - np.log(5)))
                .alias(event_flag.name)
            ])
            .collect()
            .to_series()
        )
