# -*- coding: utf-8 -*-
"""Financial statement basic operators - Polars native implementations (Phase 2, Module 9).

All operators use TRUE Polars expressions only - no pandas fallback, no NumPy.
"""
from __future__ import annotations

try:
    import polars as pl
except ImportError:  # pragma: no cover
    pl = None  # type: ignore

from cleaned_operators.base_polars import OperatorMetadata, SeriesOperator, register_operator
from cleaned_operators.base import ParamRole, ParamSpec

_SKIP = frozenset({"date", "stock_code"})
_SRC = "factor_dsl_polars_native"


def _numeric_cols(df: pl.DataFrame) -> list[str]:
    return [c for c in df.columns if c not in _SKIP]


def _with_meta(result: pl.DataFrame, source: pl.DataFrame) -> pl.DataFrame:
    if "date" in source.columns and "date" not in result.columns:
        result = result.with_columns(source["date"])
    return result


# ---------------------------------------------------------------------------
# Basic financial changes
# ---------------------------------------------------------------------------


@register_operator(
    name="fin_diff",
    category="financial",
    business_category="financial_statements",
    canonical="fin_diff",
    source=_SRC,
    backend="polars",
)
class FinDiffNative(SeriesOperator):
    """Financial statement difference: x - x.shift(periods)."""

    metadata = OperatorMetadata(
        name="fin_diff",
        category="financial",
        description="财务指标差分",
        param_names=["x", "periods"],
        return_type="series",
        tags=["financial", "polars", "native"],
    )

    def _calculate_series(self, x: pl.DataFrame, periods: int = 1, **kwargs) -> pl.DataFrame:
        from cleaned_operators.parameter_validation import strict_integer

        p = strict_integer(periods, "periods", minimum=1)
        cols = _numeric_cols(x)

        return x.with_columns([
            (pl.col(c) - pl.col(c).shift(p)).alias(c)
            for c in cols
        ])


@register_operator(
    name="fin_pct_change",
    category="financial",
    business_category="financial_statements",
    canonical="fin_pct_change",
    source=_SRC,
    backend="polars",
)
class FinPctChangeNative(SeriesOperator):
    """Financial statement percentage change: (x - x_prev) / abs(x_prev)."""

    metadata = OperatorMetadata(
        name="fin_pct_change",
        category="financial",
        description="财务指标百分比变化",
        param_names=["x", "periods"],
        return_type="series",
        tags=["financial", "polars", "native"],
    )

    def _calculate_series(self, x: pl.DataFrame, periods: int = 1, **kwargs) -> pl.DataFrame:
        from cleaned_operators.parameter_validation import strict_integer

        p = strict_integer(periods, "periods", minimum=1)
        cols = _numeric_cols(x)

        exprs = []
        for c in cols:
            prev = pl.col(c).shift(p)
            pct = pl.when(prev.abs() == 0).then(None).otherwise((pl.col(c) - prev) / prev.abs())
            exprs.append(pct.alias(c))

        return x.with_columns(exprs)


@register_operator(
    name="fin_growth",
    category="financial",
    business_category="financial_statements",
    canonical="fin_growth",
    source=_SRC,
    backend="polars",
)
class FinGrowthNative(SeriesOperator):
    """Financial growth rate: (x - x_prev) / x_prev."""

    metadata = OperatorMetadata(
        name="fin_growth",
        category="financial",
        description="财务增长率",
        param_names=["x", "periods"],
        return_type="series",
        tags=["financial", "polars", "native"],
    )

    def _calculate_series(self, x: pl.DataFrame, periods: int = 1, **kwargs) -> pl.DataFrame:
        from cleaned_operators.parameter_validation import strict_integer

        p = strict_integer(periods, "periods", minimum=1)
        cols = _numeric_cols(x)

        exprs = []
        for c in cols:
            prev = pl.col(c).shift(p)
            growth = pl.when(prev == 0).then(None).otherwise((pl.col(c) - prev) / prev)
            exprs.append(growth.alias(c))

        return x.with_columns(exprs)


@register_operator(
    name="fin_yoy",
    category="financial",
    business_category="financial_statements",
    canonical="fin_yoy",
    source=_SRC,
    backend="polars",
)
class FinYoYNative(SeriesOperator):
    """Year-over-year growth: (x - x_4q_ago) / abs(x_4q_ago)."""

    metadata = OperatorMetadata(
        name="fin_yoy",
        category="financial",
        description="同比增长率",
        param_names=["x"],
        return_type="series",
        tags=["financial", "polars", "native"],
    )

    def _calculate_series(self, x: pl.DataFrame, **kwargs) -> pl.DataFrame:
        cols = _numeric_cols(x)

        exprs = []
        for c in cols:
            prev = pl.col(c).shift(4)  # 4 quarters ago
            yoy = pl.when(prev.abs() == 0).then(None).otherwise((pl.col(c) - prev) / prev.abs())
            exprs.append(yoy.alias(c))

        return x.with_columns(exprs)


@register_operator(
    name="fin_qoq",
    category="financial",
    business_category="financial_statements",
    canonical="fin_qoq",
    source=_SRC,
    backend="polars",
)
class FinQoQNative(SeriesOperator):
    """Quarter-over-quarter growth: (x - x_1q_ago) / abs(x_1q_ago)."""

    metadata = OperatorMetadata(
        name="fin_qoq",
        category="financial",
        description="环比增长率",
        param_names=["x"],
        return_type="series",
        tags=["financial", "polars", "native"],
    )

    def _calculate_series(self, x: pl.DataFrame, **kwargs) -> pl.DataFrame:
        cols = _numeric_cols(x)

        exprs = []
        for c in cols:
            prev = pl.col(c).shift(1)  # 1 quarter ago
            qoq = pl.when(prev.abs() == 0).then(None).otherwise((pl.col(c) - prev) / prev.abs())
            exprs.append(qoq.alias(c))

        return x.with_columns(exprs)


