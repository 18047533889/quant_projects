# ---------------------------------------------------------------------------
# TTM calculations
# ---------------------------------------------------------------------------


@register_operator(
    name="fin_ttm",
    category="financial",
    business_category="financial_statements",
    canonical="fin_ttm",
    source=_SRC,
    backend="polars",
)
class FinTTMNative(SeriesOperator):
    """Trailing twelve months sum."""

    metadata = OperatorMetadata(
        name="fin_ttm",
        category="financial",
        description="最近四个季度累计",
        param_names=["x"],
        return_type="series",
        tags=["financial", "polars", "native"],
    )

    def _calculate_series(self, x: pl.DataFrame, **kwargs) -> pl.DataFrame:
        cols = _numeric_cols(x)

        exprs = []
        for c in cols:
            ttm = pl.col(c) + pl.col(c).shift(1) + pl.col(c).shift(2) + pl.col(c).shift(3)
            exprs.append(ttm.alias(c))

        return x.with_columns(exprs)


@register_operator(
    name="fin_ratio",
    category="financial",
    business_category="financial_statements",
    canonical="fin_ratio",
    source=_SRC,
    backend="polars",
)
class FinRatioNative(SeriesOperator):
    """Financial ratio: numerator / denominator."""

    metadata = OperatorMetadata(
        name="fin_ratio",
        category="financial",
        description="财务比率",
        param_names=["numerator", "denominator"],
        return_type="series",
        tags=["financial", "polars", "native"],
    )

    def _calculate_series(self, numerator: pl.DataFrame, denominator: pl.DataFrame | None = None,
                         **kwargs) -> pl.DataFrame:
        cols = _numeric_cols(numerator)

        if denominator is None:
            raise ValueError("fin_ratio requires denominator")

        exprs = []
        for c in cols:
            num = pl.col(c)
            denom = denominator[c] if c in denominator.columns else pl.lit(None)
            ratio = pl.when(denom == 0).then(None).otherwise(num / denom)
            exprs.append(ratio.alias(c))

        return numerator.with_columns(exprs)


# ---------------------------------------------------------------------------
# Growth metrics
# ---------------------------------------------------------------------------


@register_operator(
    name="fin_growth_stability",
    category="financial",
    business_category="financial_statements",
    canonical="fin_growth_stability",
    source=_SRC,
    backend="polars",
)
class FinGrowthStabilityNative(SeriesOperator):
    """Growth stability: rolling std of growth rates."""

    metadata = OperatorMetadata(
        name="fin_growth_stability",
        category="financial",
        description="增长稳定性",
        param_names=["x", "window"],
        return_type="series",
        tags=["financial", "polars", "native"],
    )

    def _calculate_series(self, x: pl.DataFrame, window: int = 8, **kwargs) -> pl.DataFrame:
        from cleaned_operators.parameter_validation import strict_integer

        w = strict_integer(window, "window", minimum=2)
        cols = _numeric_cols(x)

        exprs = []
        for c in cols:
            prev = pl.col(c).shift(1)
            growth = (pl.col(c) - prev) / prev.abs()
            stability = growth.rolling_std(window_size=w, min_samples=2)
            exprs.append(stability.alias(c))

        return x.with_columns(exprs)


@register_operator(
    name="fin_growth_acceleration",
    category="financial",
    business_category="financial_statements",
    canonical="fin_growth_acceleration",
    source=_SRC,
    backend="polars",
)
class FinGrowthAccelerationNative(SeriesOperator):
    """Growth acceleration: diff of growth rates."""

    metadata = OperatorMetadata(
        name="fin_growth_acceleration",
        category="financial",
        description="增长加速度",
        param_names=["x"],
        return_type="series",
        tags=["financial", "polars", "native"],
    )

    def _calculate_series(self, x: pl.DataFrame, **kwargs) -> pl.DataFrame:
        cols = _numeric_cols(x)

        exprs = []
        for c in cols:
            prev = pl.col(c).shift(1)
            growth = (pl.col(c) - prev) / prev.abs()
            accel = growth - growth.shift(1)
            exprs.append(accel.alias(c))

        return x.with_columns(exprs)


@register_operator(
    name="fin_staleness",
    category="financial",
    business_category="financial_statements",
    canonical="fin_staleness",
    source=_SRC,
    backend="polars",
)
class FinStalenessNative(SeriesOperator):
    """Count of periods since last meaningful change (>5%)."""

    metadata = OperatorMetadata(
        name="fin_staleness",
        category="financial",
        description="数据新鲜度",
        param_names=["x", "threshold"],
        return_type="series",
        tags=["financial", "polars", "native"],
    )

    def _calculate_series(self, x: pl.DataFrame, threshold: float = 0.05, **kwargs) -> pl.DataFrame:
        from cleaned_operators.parameter_validation import strict_finite_scalar

        thresh = strict_finite_scalar(threshold, "threshold", minimum=0.0)
        cols = _numeric_cols(x)

        exprs = []
        for c in cols:
            prev = pl.col(c).shift(1)
            pct_change = ((pl.col(c) - prev) / prev.abs()).abs()
            changed = pct_change > thresh

            # Count periods since last change
            # Reset counter when changed, otherwise increment
            staleness = (1 - changed.cast(pl.Int32)).cum_sum()
            exprs.append(staleness.cast(pl.Float64).alias(c))

        return x.with_columns(exprs)


@register_operator(
    name="fin_std",
    category="financial",
    business_category="financial_statements",
    canonical="fin_std",
    source=_SRC,
    backend="polars",
)
class FinStdNative(SeriesOperator):
    """Rolling standard deviation of financial metric."""

    metadata = OperatorMetadata(
        name="fin_std",
        category="financial",
        description="财务指标滚动标准差",
        param_names=["x", "window"],
        return_type="series",
        tags=["financial", "polars", "native"],
    )

    def _calculate_series(self, x: pl.DataFrame, window: int = 8, **kwargs) -> pl.DataFrame:
        from cleaned_operators.parameter_validation import strict_integer

        w = strict_integer(window, "window", minimum=2)
        cols = _numeric_cols(x)

        return x.with_columns([
            pl.col(c).rolling_std(window_size=w, min_samples=2).alias(c)
            for c in cols
        ])


@register_operator(
    name="fin_cv",
    category="financial",
    business_category="financial_statements",
    canonical="fin_cv",
    source=_SRC,
    backend="polars",
)
class FinCVNative(SeriesOperator):
    """Coefficient of variation: std / mean."""

    metadata = OperatorMetadata(
        name="fin_cv",
        category="financial",
        description="变异系数",
        param_names=["x", "window"],
        return_type="series",
        tags=["financial", "polars", "native"],
    )

    def _calculate_series(self, x: pl.DataFrame, window: int = 8, **kwargs) -> pl.DataFrame:
        from cleaned_operators.parameter_validation import strict_integer

        w = strict_integer(window, "window", minimum=2)
        cols = _numeric_cols(x)

        exprs = []
        for c in cols:
            mean = pl.col(c).rolling_mean(window_size=w, min_samples=2)
            std = pl.col(c).rolling_std(window_size=w, min_samples=2)
            cv = pl.when(mean == 0).then(None).otherwise(std / mean.abs())
            exprs.append(cv.alias(c))

        return x.with_columns(exprs)


@register_operator(
    name="fin_positive_streak",
    category="financial",
    business_category="financial_statements",
    canonical="fin_positive_streak",
    source=_SRC,
    backend="polars",
)
class FinPositiveStreakNative(SeriesOperator):
    """Count of consecutive positive values."""

    metadata = OperatorMetadata(
        name="fin_positive_streak",
        category="financial",
        description="连续正值计数",
        param_names=["x"],
        return_type="series",
        tags=["financial", "polars", "native"],
    )

    def _calculate_series(self, x: pl.DataFrame, **kwargs) -> pl.DataFrame:
        cols = _numeric_cols(x)

        exprs = []
        for c in cols:
            is_positive = (pl.col(c) > 0).cast(pl.Int32)
            # Reset counter when not positive
            streak = is_positive.cum_sum() - is_positive.cum_sum().fill_null(0).shift().fill_null(0) * (1 - is_positive)
            exprs.append(streak.cast(pl.Float64).alias(c))

        return x.with_columns(exprs)


@register_operator(
    name="fin_sign_change_count",
    category="financial",
    business_category="financial_statements",
    canonical="fin_sign_change_count",
    source=_SRC,
    backend="polars",
)
class FinSignChangeCountNative(SeriesOperator):
    """Rolling count of sign changes."""

    metadata = OperatorMetadata(
        name="fin_sign_change_count",
        category="financial",
        description="滚动符号变化计数",
        param_names=["x", "window"],
        return_type="series",
        tags=["financial", "polars", "native"],
    )

    def _calculate_series(self, x: pl.DataFrame, window: int = 8, **kwargs) -> pl.DataFrame:
        from cleaned_operators.parameter_validation import strict_integer

        w = strict_integer(window, "window", minimum=2)
        cols = _numeric_cols(x)

        exprs = []
        for c in cols:
            sign_curr = pl.col(c).sign()
            sign_prev = sign_curr.shift(1)
            changed = (sign_curr != sign_prev).cast(pl.Float64)
            count = changed.rolling_sum(window_size=w, min_samples=1)
            exprs.append(count.alias(c))

        return x.with_columns(exprs)


@register_operator(
    name="ttm_from_quarterly",
    category="financial",
    business_category="financial_statements",
    canonical="ttm_from_quarterly",
    source=_SRC,
    backend="polars",
)
class TTMFromQuarterlyNative(SeriesOperator):
    """Convert quarterly flow data to TTM."""

    metadata = OperatorMetadata(
        name="ttm_from_quarterly",
        category="financial",
        description="季度数据转TTM",
        param_names=["x"],
        return_type="series",
        tags=["financial", "polars", "native"],
    )

    def _calculate_series(self, x: pl.DataFrame, **kwargs) -> pl.DataFrame:
        cols = _numeric_cols(x)

        exprs = []
        for c in cols:
            ttm = pl.col(c) + pl.col(c).shift(1) + pl.col(c).shift(2) + pl.col(c).shift(3)
            exprs.append(ttm.alias(c))

        return x.with_columns(exprs)
