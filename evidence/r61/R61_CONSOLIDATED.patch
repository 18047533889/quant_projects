+def _build_diff_matrix(size: int, order: int) -> "np.ndarray":
+    """Build the first/second difference operator D (size-order, size)."""
+    if order == 1:
+        D = np.zeros((size - 1, size))
+        idx = np.arange(size - 1)
+        D[idx, idx] = -1.0
+        D[idx, idx + 1] = 1.0
+    else:
+        D = np.zeros((size - 2, size))
+        idx = np.arange(size - 2)
+        D[idx, idx] = 1.0
+        D[idx, idx + 1] = -2.0
+        D[idx, idx + 2] = 1.0
+    return D
+
