+    m1s = np.maximum(m1, 1.0)
+    hi1 = np.clip(lf + 1, 0, n)
+    lo1 = np.clip(s + 1, 0, n)
+    sum1 = CD1[hi1] - CD1[lo1]
+    ssq1 = CD1sq[hi1] - CD1sq[lo1]
+    with np.errstate(divide="ignore", invalid="ignore"):
+        mean1 = sum1 / m1s
