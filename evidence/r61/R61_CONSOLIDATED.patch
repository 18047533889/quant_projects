+    elif stat == "innovation_z":
+        Syy = cs["yy"][np.where(ok, t_hi, 0) + 1] - cs["yy"][np.where(ok, t_lo, 0)]
+        cLy = c  # [sum y, sum yL_j]
+        bb = np.where(np.isfinite(beta), beta, 0.0)
