  "code": "def factor_drawdown_stress_atr(df):\n    df_copy = df.copy()\n    roll_max = df_copy[\"close\"].rolling(60, min_periods=60).max()\n    drawdown = (roll_max - df_copy[\"close\"]) / roll_max.replace(0.0, np.nan)\n    atr = pd.Series(talib.ATR(df_copy[\"high\"].astype(np.float64).values, df_copy[\"low\"].astype(np.float64).values, df_copy[\"close\"].astype(np.float64).values, timeperiod=20), index=df_copy.index)\n    atr_ratio = atr / df_copy[\"close\"].replace(0.0, np.nan)\n    factor = drawdown / atr_ratio.replace(0.0, np.nan)\n    factor.name = \"factor_drawdown_stress_atr\"\n    return factor",
