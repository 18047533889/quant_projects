  "code": "def factor_drawdown_duration_simple(df):\n    df_copy = df.copy()\n    high_60 = df_copy[\"high\"].rolling(60, min_periods=60).max()\n    in_drawdown = (df_copy[\"close\"] < high_60.shift(1)).astype(float)\n    resvol_high = df_copy[\"style_gate_resvol_high\"] > 0\n    factor_low_vol = in_drawdown.ewm(span=10, min_periods=1).mean()\n    factor_high_vol = in_drawdown.ewm(span=40, min_periods=1).mean()\n    factor = np.where(resvol_high, factor_high_vol, factor_low_vol)\n    df_copy[\"factor_drawdown_duration_simple\"] = factor\n    return df_copy[\"factor_drawdown_duration_simple\"]",
