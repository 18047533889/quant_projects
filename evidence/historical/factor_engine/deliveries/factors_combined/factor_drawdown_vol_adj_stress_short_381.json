  "code": "def factor_drawdown_vol_adj_stress_short(df):\n    df_copy = df.copy()\n    rolling_max = df_copy['close'].rolling(10, min_periods=10).max()\n    drawdown = (df_copy['close'] / rolling_max) - 1.0\n    high = df_copy['high'].values.astype(np.float64)\n    low = df_copy['low'].values.astype(np.float64)\n    close = df_copy['close'].values.astype(np.float64)\n    atr = pd.Series(talib.ATR(high, low, close, timeperiod=10), index=df_copy.index)\n    atr = atr.replace(0.0, np.nan)\n    normalized_dd = drawdown / atr\n    factor = normalized_dd.rolling(5, min_periods=5).sum()\n    df_copy['factor_drawdown_vol_adj_stress_short'] = factor\n    return df_copy['factor_drawdown_vol_adj_stress_short']",
