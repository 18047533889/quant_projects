  "code": "def factor_downside_volatility_ratio_long(df):\n    df_copy = df.copy()\n    close = df_copy[\"close\"]\n    ret = close.pct_change()\n    neg_ret = ret.where(ret < 0, 0.0)\n    window = 40\n    down_vol = neg_ret.rolling(window, min_periods=window).std(ddof=1)\n    total_vol = ret.rolling(window, min_periods=window).std(ddof=1)\n    total_vol_safe = total_vol.replace(0, np.nan)\n    factor = down_vol / total_vol_safe\n    factor = factor.fillna(0.5)\n    df_copy[\"factor_downside_volatility_ratio_long\"] = factor\n    return df_copy[\"factor_downside_volatility_ratio_long\"]",
