  "code": "def factor_breakdown_breadth(df):\n    df_copy = df.copy()\n    range_ = df_copy['high'] - df_copy['low']\n    close_ret = df_copy['close'].pct_change()\n    # align range to start at period 1\n    range_shifted = range_.shift(1)\n    # rolling volatility of close returns over 20 days\n    close_vol = close_ret.rolling(20, min_periods=10).std()\n    # rolling average of range over 5 days\n    range_ma = range_.rolling(5, min_periods=3).mean()\n    # ratio of current range to close volatility as a breakdown signal\n    # when range expands relative to close vol, potential breakdown\n    factor = range_ / close_vol.replace(0, np.nan)\n    # smooth a bit with previous period to reduce noise\n    factor = factor.rolling(2).mean()\n    df_copy['factor_breakdown_breadth'] = factor\n    return df_copy['factor_breakdown_breadth']",
