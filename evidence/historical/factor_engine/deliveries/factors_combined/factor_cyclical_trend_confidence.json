  "code": "def factor_cyclical_trend_confidence(df):\n    df_copy = df.copy()\n    pdi = pd.Series(talib.PLUS_DI(df_copy['high'], df_copy['low'], df_copy['close'], timeperiod=50), index=df_copy.index)\n    mdi = pd.Series(talib.MINUS_DI(df_copy['high'], df_copy['low'], df_copy['close'], timeperiod=50), index=df_copy.index)\n    adx = pd.Series(talib.ADX(df_copy['high'], df_copy['low'], df_copy['close'], timeperiod=50), index=df_copy.index)\n    di_spread = pdi - mdi\n    raw_signal = di_spread * (adx / 100.0)\n    factor = pd.Series(talib.EMA(raw_signal, timeperiod=20), index=df_copy.index)\n    df_copy[\"factor_cyclical_trend_confidence\"] = factor\n    return df_copy[\"factor_cyclical_trend_confidence\"]",
