  "code": "def factor_signed_path_efficiency_cycle(df):\n    \"\"\"Measure whether the recent price path is forming a persistent directional phase.\"\"\"\n    df_copy = df.copy()\n    close = df_copy[\"close\"]\n    net_move = close - close.shift(126)\n    path_length = close.diff().abs().rolling(126, min_periods=126).sum()\n    efficiency = net_move / path_length.replace(0.0, np.nan)\n    recent_efficiency = (close - close.shift(42)) / close.diff().abs().rolling(42, min_periods=42).sum().replace(0.0, np.nan)\n    phase_signal = efficiency * recent_efficiency.abs()\n    df_copy[\"factor_signed_path_efficiency_cycle\"] = phase_signal.replace([np.inf, -np.inf], np.nan)\n    return df_copy[\"factor_signed_path_efficiency_cycle\"]",
