  "code": "def factor_size_adaptive_value(df):\n    df_copy = df.copy()\n    # Small cap: book yield with leverage penalty\n    book_yield = 1.0 / df_copy[\"pb_lf\"].replace(0, np.nan)\n    leverage_penalty = 1.0 - df_copy[\"debttoassets\"] / 100.0\n    leverage_penalty = leverage_penalty.clip(0, 1)\n    small_value = book_yield * leverage_penalty\n    # Large cap: earnings yield with profitability boost\n    earnings_yield = 1.0 / df_copy[\"pe_ttm\"].replace(0, np.nan)\n    quality = df_copy[\"roe_ttm2\"] / 100.0\n    large_value = earnings_yield * (1.0 + quality)\n    # Condition on size regime\n    is_small = df_copy[\"style_gate_size_small\"] == 1\n    is_large = df_copy[\"style_gate_size_large\"] == 1\n    # Default: use large value for other regimes (e.g., mid-cap)\n    signal = large_value.copy()\n    signal[is_small] = small_value[is_small]\n    signal.name = 'factor_size_adaptive_value'\n    return signal",
