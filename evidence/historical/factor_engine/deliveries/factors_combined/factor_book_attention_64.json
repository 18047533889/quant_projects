  "code": "def factor_book_attention(df):\n    df_copy = df.copy()\n    book_yield = 1.0 / df_copy['pb_lf'].replace(0, np.nan)\n    inattention = 1.0 - df_copy['free_turn'].rolling(20, min_periods=10).rank(pct=True).fillna(0.5)\n    df_copy['factor_book_attention'] = book_yield * inattention\n    return df_copy['factor_book_attention']",
