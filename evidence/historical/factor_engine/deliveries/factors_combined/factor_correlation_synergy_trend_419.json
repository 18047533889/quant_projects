  "code": "def factor_correlation_synergy_trend(df):\n    df_copy = df.copy()\n    price_roc = df_copy['close'].pct_change(20)\n    volume_roc = df_copy['volume'].pct_change(20)\n    corr = price_roc.rolling(30).corr(volume_roc).clip(0, 1).fillna(0)\n    short_trend = (df_copy['close'].rolling(10).mean() / df_copy['close'].rolling(40).mean() - 1)\n    long_trend = (df_copy['close'].rolling(20).mean() / df_copy['close'].rolling(80).mean() - 1)\n    factor = short_trend * corr + long_trend * (1 - corr)\n    factor.name = 'factor_correlation_synergy_trend'\n    return factor",
