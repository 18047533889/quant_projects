  "code": "def factor_trend_cycle_pct(df):\n    df_copy = df.copy()\n    sma200 = df_copy[\"close\"].rolling(200, min_periods=200).mean()\n    pct_dev = (df_copy[\"close\"] / sma200) - 1\n    df_copy[\"factor_trend_cycle_pct\"] = pct_dev\n    return df_copy[\"factor_trend_cycle_pct\"]",
