  "code": "def factor_book_yield_adjusted_for_smooth_leverage(df):\n    df_copy = df.copy()\n    by = 1.0 / df_copy['pb_lf'].replace(0, np.nan)\n    lev = df_copy['debttoassets'] / 100.0\n    lev_smooth = lev.rolling(4, min_periods=2).mean()\n    factor = by / (1.0 + lev_smooth)\n    return factor.rename('factor_book_yield_adjusted_for_smooth_leverage')",
