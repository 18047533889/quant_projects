  "code": "def factor_breakdown_compression_smoothed(df):\n    df_copy = df.copy()\n    range_ = df_copy['high'] - df_copy['low']\n    range_ma = range_.rolling(5, min_periods=3).mean()\n    close_ret = df_copy['close'].pct_change()\n    close_vol = close_ret.rolling(20, min_periods=10).std(ddof=1)\n    factor = -(range_ma / close_vol.replace(0, np.nan))\n    factor = factor.rolling(2).mean()\n    df_copy['factor_breakdown_compression_smoothed'] = factor\n    return df_copy['factor_breakdown_compression_smoothed']",
