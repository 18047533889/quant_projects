  "code": "def factor_value_health(df):\n    df_copy = df.copy()\n    pb = df_copy[\"pb_lf\"]\n    cheapness = 1.0 / pb.replace(0, np.nan)\n    cheapness = cheapness.where(pb > 0, np.nan)\n    debt_ratio = df_copy[\"debttoassets\"] / 100.0\n    health = (1.0 - debt_ratio).clip(0, 1)\n    composite = cheapness * health\n    composite = composite.replace([np.inf, -np.inf], np.nan)\n    composite.name = \"factor_value_health\"\n    return composite",
