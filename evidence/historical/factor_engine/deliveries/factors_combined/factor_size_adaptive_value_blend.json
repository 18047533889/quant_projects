  "code": "def factor_size_adaptive_value_blend(df):\n    df_copy = df.copy()\n    size_rank = df_copy[\"mkt_cap_float\"].rolling(252, min_periods=60).rank(pct=True)\n    w_large = 1.0 / (1.0 + np.exp(-10.0 * (size_rank - 0.5)))\n    w_small = 1.0 - w_large\n    pe_positive = df_copy[\"pe_ttm\"].where(df_copy[\"pe_ttm\"] > 0, np.nan)\n    ey = 1.0 / pe_positive\n    pb_positive = df_copy[\"pb_lf\"].where(df_copy[\"pb_lf\"] > 0, np.nan)\n    by = 1.0 / pb_positive\n    debt_ratio = df_copy[\"debttoassets\"] / 100.0\n    roe_ratio = df_copy[\"roe_ttm2\"] / 100.0\n    small_val = by * (1.0 - debt_ratio)\n    large_val = ey * (1.0 + roe_ratio)\n    factor = w_small * small_val + w_large * large_val\n    df_copy[\"factor_size_adaptive_value_blend\"] = factor\n    return df_copy[\"factor_size_adaptive_value_blend\"]",
