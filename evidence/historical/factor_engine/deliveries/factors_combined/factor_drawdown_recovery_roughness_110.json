  "code": "def factor_drawdown_recovery_roughness(df):\n    df_copy = df.copy()\n    window = 60\n    rolling_high = df_copy['high'].rolling(window=window, min_periods=1).max()\n    drawdown = (rolling_high - df_copy['close']) / rolling_high\n    dd_change = drawdown.diff()\n    recovery_speed = -dd_change / (drawdown + 1e-10)\n    returns = df_copy['close'].pct_change()\n    roughness = returns.rolling(window=20, min_periods=1).std()\n    factor = roughness * drawdown * recovery_speed\n    factor = factor.fillna(0).replace([np.inf, -np.inf], 0)\n    factor.name = 'factor_drawdown_recovery_roughness'\n    return factor",
