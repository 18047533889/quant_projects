  "code": "def factor_vwap_squared_deviation_intensity(df):\n    df_copy = df.copy()\n    vwap = (df_copy['close_price'] * df_copy['volume']).sum() / df_copy['volume'].sum()\n    deviation = (df_copy['close_price'] - vwap) ** 2\n    is_high, volume_z = minute_tools.get_up_space(df_copy['volume'], df_copy['TradingDay'], std_multiplier=1.0)\n    weight = volume_z.clip(lower=0)\n    weighted_dev = deviation * weight\n    sum_weight = weight.sum()\n    value = (weighted_dev.sum() / sum_weight) if sum_weight > 0 else 0.0\n    day = pd.Timestamp(df_copy['TradingDay'].iloc[0])\n    return pd.Series([value], index=[day], name='factor_vwap_squared_deviation_intensity')",
