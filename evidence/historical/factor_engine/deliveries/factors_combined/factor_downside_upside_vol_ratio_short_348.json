  "code": "def factor_downside_upside_vol_ratio_short(df):\n    df_copy = df.copy()\n    returns = df_copy['close'].pct_change()\n    pos_ret = returns.where(returns > 0, 0.0)\n    neg_ret = returns.where(returns < 0, 0.0)\n    window = 30\n    vol_up = pos_ret.rolling(window, min_periods=int(window/2)).std(ddof=1)\n    vol_down = neg_ret.rolling(window, min_periods=int(window/2)).std(ddof=1)\n    ratio = vol_down / vol_up.replace(0, np.nan)\n    ratio = ratio.replace([np.inf, -np.inf], np.nan)\n    df_copy['factor_downside_upside_vol_ratio_short'] = ratio\n    return df_copy['factor_downside_upside_vol_ratio_short']",
