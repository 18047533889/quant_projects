  "code": "def factor_overnight_intraday_downside_amplification(df):\n    df_copy = df.copy()\n    overnight_ret, intraday_ret = alpha_tools.decompose_overnight_intraday(df_copy[\"close\"], df_copy[\"open\"])\n    down_overnight = (-overnight_ret.clip(upper=0.0)).rolling(12, min_periods=12).mean()\n    up_intraday = intraday_ret.clip(lower=0.0).rolling(12, min_periods=12).mean()\n    intraday_vol = (df_copy[\"high\"] - df_copy[\"low\"]).rolling(12, min_periods=12).std(ddof=1)\n    close_vol = df_copy[\"close\"].pct_change().abs().rolling(12, min_periods=12).mean()\n    asym = (down_overnight + close_vol) / (up_intraday + intraday_vol + 1e-12)\n    df_copy[\"factor_overnight_intraday_downside_amplification\"] = np.log1p(asym)\n    return df_copy[\"factor_overnight_intraday_downside_amplification\"]",
