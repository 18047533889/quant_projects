  "code": "def factor_ewm_downside_variance_resilience(df):\n    \"\"\"Resilience from the exponentially weighted share of variance occurring on down days.\"\"\"\n    df_copy = df.copy()\n    ret = df_copy[\"close\"].pct_change()\n    downside_energy = ret.clip(upper=0.0).pow(2).ewm(span=24, adjust=False, min_periods=24).mean()\n    total_energy = ret.pow(2).ewm(span=24, adjust=False, min_periods=24).mean()\n    df_copy[\"factor_ewm_downside_variance_resilience\"] = -(downside_energy / total_energy.replace(0.0, np.nan))\n    return df_copy[\"factor_ewm_downside_variance_resilience\"]",
