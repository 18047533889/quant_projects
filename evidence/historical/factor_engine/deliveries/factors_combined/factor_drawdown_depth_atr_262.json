  "code": "def factor_drawdown_depth_atr(df):\n    df_copy = df.copy()\n    peak = df_copy[\"close\"].rolling(42, min_periods=42).max()\n    dd = (df_copy[\"close\"] - peak) / peak\n    depth = (-dd)\n    atr = talib.ATR(df_copy[\"high\"], df_copy[\"low\"], df_copy[\"close\"], timeperiod=21)\n    normalized_depth = depth / atr.replace(0, np.nan)\n    factor = normalized_depth.fillna(0)\n    df_copy[\"factor_drawdown_depth_atr\"] = factor\n    return df_copy[\"factor_drawdown_depth_atr\"]",
