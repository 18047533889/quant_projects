  "code": "def factor_price_impact_vol_adj_stable_vol(df):\n    df_copy = df.copy()\n    close = df_copy['close']\n    volume = df_copy['volume']\n    ret = close / close.shift(1) - 1.0\n    abs_ret = ret.abs()\n    # Price impact per unit volume\n    impact = abs_ret / volume.replace(0, np.nan)\n    avg_impact = impact.rolling(20, min_periods=20).mean()\n    # Longer-term volatility for stability\n    vol = ret.rolling(40, min_periods=40).std(ddof=1).replace(0, np.nan)\n    factor = avg_impact / vol\n    factor = factor.replace([np.inf, -np.inf], np.nan).fillna(0)\n    df_copy['factor_price_impact_vol_adj_stable_vol'] = factor\n    return df_copy['factor_price_impact_vol_adj_stable_vol']",
