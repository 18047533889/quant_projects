  "code": "def factor_high_volume_squared_return_weighted_impact(df):\n    df_copy = df.copy()\n    ret_sq = df_copy[\"close_price\"].pct_change().fillna(0.0) ** 2\n    is_high, _ = minute_tools.get_up_space(df_copy[\"volume\"], df_copy[\"TradingDay\"], std_multiplier=1.5)\n    numerator = (ret_sq * df_copy[\"amount\"] * is_high).sum()\n    denominator = (df_copy[\"amount\"] * is_high).sum()\n    value = numerator / denominator if denominator != 0 else 0.0\n    day = pd.Timestamp(df_copy[\"TradingDay\"].iloc[0])\n    out = pd.Series([value], index=[day], name=\"factor_high_volume_squared_return_weighted_impact\")\n    return out",
