  "code": "def factor_attentive_sales_yield(df):\n    df_copy = df.copy()\n    sales_yield = 1.0 / df_copy[\"ps_ttm\"].replace(0, np.nan)\n    inattention = 1.0 - df_copy[\"free_turn\"].rolling(20, min_periods=1).rank(pct=True)\n    sales_yield = sales_yield.ffill()\n    inattention = inattention.ffill()\n    df_copy[\"factor_attentive_sales_yield\"] = sales_yield * inattention\n    return df_copy[\"factor_attentive_sales_yield\"]",
