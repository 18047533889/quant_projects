  "code": "def factor_trend_directional_confidence(df):\n    df_copy = df.copy()\n    close = df_copy[\"close\"]\n    high = df_copy[\"high\"]\n    low = df_copy[\"low\"]\n    # primary: trend cycle position\n    sma200 = close.rolling(200, min_periods=200).mean()\n    tr = pd.concat([high - low, (high - close.shift(1)).abs(), (low - close.shift(1)).abs()], axis=1).max(axis=1)\n    atr20 = tr.rolling(20, min_periods=20).mean()\n    position = (close - sma200) / atr20.replace(0, np.nan)\n    # lightweight modifier: directional efficiency\n    ret_abs = close.pct_change().abs()\n    range_ = high - low\n    range_ = range_.clip(lower=1e-8)\n    efficiency = ret_abs / range_\n    eff_smooth = efficiency.rolling(10).median()\n    factor = position * eff_smooth\n    df_copy[\"factor_trend_directional_confidence\"] = factor\n    return df_copy[\"factor_trend_directional_confidence\"]",
