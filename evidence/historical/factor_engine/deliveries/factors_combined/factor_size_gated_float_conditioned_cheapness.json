  "code": "def factor_size_gated_float_conditioned_cheapness(df):\n    df_copy = df.copy()\n    cheapness = 1.0 / df_copy[\"pb_lf\"].replace(0, np.nan)\n    float_adj = 1.0 / np.log1p(df_copy[\"free_float_shares\"].clip(lower=1e6))\n    debt_ratio = df_copy[\"debttoassets\"] / 100.0\n    is_large = df_copy[\"style_gate_size_large\"]\n    penalty = 1.0 / (1.0 + debt_ratio)\n    factor = np.where(is_large == 1, cheapness * float_adj, cheapness * float_adj * penalty)\n    factor_series = pd.Series(factor, index=df_copy.index)\n    return factor_series.rename(\"factor_size_gated_float_conditioned_cheapness\")",
