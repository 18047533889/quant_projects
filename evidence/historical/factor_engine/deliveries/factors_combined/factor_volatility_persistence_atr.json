  "code": "def factor_volatility_persistence_atr(df):\n    df_copy = df.copy()\n    atr = talib.ATR(df_copy[\"high\"], df_copy[\"low\"], df_copy[\"close\"], timeperiod=14)\n    atr = atr.replace(0.0, np.nan)\n    inv_atr = 1.0 / atr\n    factor = inv_atr.ewm(span=10, min_periods=10, adjust=False).mean()\n    df_copy[\"factor_volatility_persistence_atr\"] = factor\n    return df_copy[\"factor_volatility_persistence_atr\"]",
