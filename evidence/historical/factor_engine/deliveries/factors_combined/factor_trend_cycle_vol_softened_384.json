  "code": "def factor_trend_cycle_vol_softened(df):\n    df_copy = df.copy()\n    sma200 = df_copy[\"close\"].rolling(200, min_periods=200).mean()\n    pct_dev = (df_copy[\"close\"] / sma200) - 1\n    ret = df_copy[\"close\"].pct_change()\n    vol = ret.rolling(20).std()\n    vol_med = vol.rolling(60).median().replace(0.0, np.nan)\n    vol_ratio = vol / vol_med\n    weight = 1 / (1 + vol_ratio**2)\n    weight = weight.fillna(0.5)\n    factor = pct_dev * weight\n    df_copy[\"factor_trend_cycle_vol_softened\"] = factor\n    return df_copy[\"factor_trend_cycle_vol_softened\"]",
