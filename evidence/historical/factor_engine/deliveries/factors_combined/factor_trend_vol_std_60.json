  "code": "def factor_trend_vol_std_60(df):\n    df_copy = df.copy()\n    close = df_copy[\"close\"]\n    ema_short = talib.EMA(close, timeperiod=20)\n    ema_long = talib.EMA(close, timeperiod=50)\n    trend = (ema_short - ema_long) / close\n    daily_ret = close.pct_change()\n    vol = daily_ret.rolling(60, min_periods=60).std(ddof=0).replace(0.0, np.nan)\n    factor = trend / vol\n    df_copy[\"factor_trend_vol_std_60\"] = factor\n    return df_copy[\"factor_trend_vol_std_60\"]",
