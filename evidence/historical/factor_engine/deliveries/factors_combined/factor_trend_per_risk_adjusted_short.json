  "code": "def factor_trend_per_risk_adjusted_short(df):\n    df_copy = df.copy()\n    ema20 = talib.EMA(df_copy[\"close\"], timeperiod=20)\n    ema50 = talib.EMA(df_copy[\"close\"], timeperiod=50)\n    trend_diff = (ema20 - ema50) / df_copy[\"close\"]\n    atr = talib.ATR(df_copy[\"high\"], df_copy[\"low\"], df_copy[\"close\"], timeperiod=14)\n    vol = atr / df_copy[\"close\"]\n    factor = trend_diff / (vol + 1e-8)\n    df_copy[\"factor_trend_per_risk_adjusted_short\"] = factor\n    return df_copy[\"factor_trend_per_risk_adjusted_short\"]",
