  "code": "def factor_book_yield_leverage(df):\n    df_copy = df.copy()\n    book_yield = 1.0 / df_copy[\"pb_lf\"].replace(0, np.nan)\n    debt_ratio = df_copy[\"debttoassets\"] / 100.0\n    adj = (1 - debt_ratio).clip(lower=0.1, upper=1.0)\n    result = book_yield * adj\n    result.name = \"factor_book_yield_leverage\"\n    return result",
