  "code": "def factor_trend_phase_vol_adjusted_short(df):\n    df_copy = df.copy()\n    ema20 = talib.EMA(df_copy[\"close\"], timeperiod=20)\n    ema50 = talib.EMA(df_copy[\"close\"], timeperiod=50)\n    trend_diff = (ema20 - ema50) / df_copy[\"close\"]\n    atr = talib.ATR(df_copy[\"high\"], df_copy[\"low\"], df_copy[\"close\"], timeperiod=14)\n    vol_factor = 1 - (atr / df_copy[\"close\"]).replace(np.inf, np.nan).fillna(0)\n    factor = trend_diff * vol_factor\n    df_copy[\"factor_trend_phase_vol_adjusted_short\"] = factor\n    return df_copy[\"factor_trend_phase_vol_adjusted_short\"]",
