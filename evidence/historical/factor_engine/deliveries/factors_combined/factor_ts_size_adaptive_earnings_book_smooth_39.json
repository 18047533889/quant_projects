  "code": "def factor_ts_size_adaptive_earnings_book_smooth(df):\n    df_copy = df.copy()\n    size_mean = df_copy['mkt_cap_float'].rolling(60, min_periods=20).mean()\n    size_std = df_copy['mkt_cap_float'].rolling(60, min_periods=20).std(ddof=0)\n    size_z = (df_copy['mkt_cap_float'] - size_mean) / size_std.replace(0, np.nan)\n    size_z = np.clip(size_z, -10, 10)\n    ey = 1.0 / df_copy['pe_ttm'].replace(0, np.nan)\n    by = 1.0 / df_copy['pb_lf'].replace(0, np.nan)\n    lev = df_copy['debttoassets'] / 100.0\n    lev_penalty = (1.0 - lev).clip(lower=0.0)\n    weight = 1.0 / (1.0 + np.exp(-size_z))\n    df_copy['factor_ts_size_adaptive_earnings_book_smooth'] = weight * ey + (1.0 - weight) * by * lev_penalty\n    return df_copy['factor_ts_size_adaptive_earnings_book_smooth']",
