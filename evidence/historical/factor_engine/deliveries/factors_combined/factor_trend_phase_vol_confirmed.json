  "code": "def factor_trend_phase_vol_confirmed(df):\n    df_copy = df.copy()\n    # Primary: trend phase vol adjusted\n    ema50 = talib.EMA(df_copy[\"close\"], timeperiod=50)\n    ema200 = talib.EMA(df_copy[\"close\"], timeperiod=200)\n    trend_diff = (ema50 - ema200) / df_copy[\"close\"]\n    atr = talib.ATR(df_copy[\"high\"], df_copy[\"low\"], df_copy[\"close\"], timeperiod=14)\n    vol_factor = 1 - (atr / df_copy[\"close\"]).replace(np.inf, np.nan).fillna(0)\n    trend_phase = trend_diff * vol_factor\n    # Lightweight modifier: volume trend ratio\n    vol_ema_short = talib.EMA(df_copy[\"volume\"], timeperiod=10)\n    vol_ema_long = talib.EMA(df_copy[\"volume\"], timeperiod=30)\n    volume_trend = vol_ema_short / vol_ema_long.replace(0, np.nan)\n    # Combine\n    factor = trend_phase * volume_trend\n    df_copy[\"factor_trend_phase_vol_confirmed\"] = factor\n    return df_copy[\"factor_trend_phase_vol_confirmed\"]",
