  "code": "def factor_asymmetry_positive(df):\n    df_copy = df.copy()\n    ret = df_copy[\"close\"].pct_change()\n    pos_ret = ret.clip(lower=0)\n    neg_ret = ret.clip(upper=0)\n    upside_vol = pos_ret.rolling(20, min_periods=20).std(ddof=1)\n    downside_vol = neg_ret.rolling(20, min_periods=20).std(ddof=1)\n    factor = upside_vol - downside_vol\n    df_copy[\"factor_asymmetry_positive\"] = factor\n    return df_copy[\"factor_asymmetry_positive\"]",
