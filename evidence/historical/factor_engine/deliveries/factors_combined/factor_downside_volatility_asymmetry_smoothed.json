  "code": "def factor_downside_volatility_asymmetry_smoothed(df):\n    df_copy = df.copy()\n    ret = df_copy[\"close\"] / df_copy[\"close\"].shift(1) - 1\n    pos_ret = ret.where(ret > 0, 0)\n    neg_ret = ret.where(ret < 0, 0).abs()\n    pos_std = pos_ret.rolling(20).std()\n    neg_std = neg_ret.rolling(20).std()\n    ratio = neg_std / pos_std.replace(0, np.nan)\n    ratio_smoothed = ratio.ewm(span=10, min_periods=10, adjust=False).mean()\n    factor = ratio_smoothed\n    factor.name = \"factor_downside_volatility_asymmetry_smoothed\"\n    return factor",
