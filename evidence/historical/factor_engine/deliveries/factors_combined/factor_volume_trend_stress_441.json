  "code": "def factor_volume_trend_stress(df):\n    df_copy = df.copy()\n    close = df_copy['close']\n    volume = df_copy['volume']\n    abs_ret = close.pct_change().abs()\n    vol_short = volume.ewm(span=10, min_periods=10).mean()\n    vol_long = volume.ewm(span=30, min_periods=30).mean()\n    vol_trend = (vol_short / vol_long.replace(0, np.nan)) - 1.0\n    stress = abs_ret * vol_trend\n    stress_accum = stress.rolling(20, min_periods=20).sum()\n    stress_accum.name = 'factor_volume_trend_stress'\n    return stress_accum",
