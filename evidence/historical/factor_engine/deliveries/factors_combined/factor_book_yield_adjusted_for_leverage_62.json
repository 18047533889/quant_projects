  "code": "def factor_book_yield_adjusted_for_leverage(df):\n    df_copy = df.copy()\n    # Book yield: inverse of PB, replace zero/negative with NaN\n    by = 1.0 / df_copy['pb_lf'].replace(0, np.nan)\n    # Debt-to-assets as ratio (percentage, divide by 100)\n    lev = df_copy['debttoassets'] / 100.0\n    # Adjust book yield: discount by leverage\n    factor = by / (1.0 + lev)\n    return factor.rename('factor_book_yield_adjusted_for_leverage')",
