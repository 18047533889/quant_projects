  "code": "def factor_cyclical_pressure_atrlib(df):\n    df_copy = df.copy()\n    atr = talib.ATR(df_copy[\"high\"], df_copy[\"low\"], df_copy[\"close\"], timeperiod=90)\n    atr_change = atr / atr.shift(20) - 1\n    return atr_change.fillna(0).rename('factor_cyclical_pressure_atrlib')",
