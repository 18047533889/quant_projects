  "code": "def factor_drawdown_stress_ratio_simplified(df):\n    df_copy = df.copy()\n    close = df_copy['close']\n    roll_max = close.rolling(60).max()\n    drawdown = (roll_max - close) / roll_max\n    dd_sum = drawdown.rolling(60).sum()\n    returns = close.pct_change()\n    vol = returns.rolling(60).std(ddof=1)\n    raw = dd_sum / vol.replace(0.0, np.nan)\n    factor_values = raw.fillna(0.0)\n    factor_values.name = \"factor_drawdown_stress_ratio_simplified\"\n    return factor_values",
