  "code": "def factor_trend_vol_scaled_short(df):\n    df_copy = df.copy()\n    ema20 = talib.EMA(df_copy[\"close\"], timeperiod=20)\n    ema50 = talib.EMA(df_copy[\"close\"], timeperiod=50)\n    trend = (ema20 - ema50) / df_copy[\"close\"]\n    returns = df_copy[\"close\"].pct_change()\n    vol = returns.rolling(60).std()\n    factor = trend / vol.replace(0.0, np.nan)\n    df_copy[\"factor_trend_vol_scaled_short\"] = factor.fillna(0.0)\n    return df_copy[\"factor_trend_vol_scaled_short\"]",
