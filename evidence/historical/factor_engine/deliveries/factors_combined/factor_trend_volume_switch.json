  "code": "def factor_trend_volume_switch(df):\n    df_copy = df.copy()\n    short_trend = (df_copy['close'].rolling(10).mean() / df_copy['close'].rolling(40).mean() - 1)\n    long_trend = (df_copy['close'].rolling(20).mean() / df_copy['close'].rolling(80).mean() - 1)\n    is_high_vol, is_low_vol, vol_ratio = alpha_tools.classify_volume_regime(df_copy['volume'], window=20)\n    df_copy['factor_trend_volume_switch'] = np.where(is_high_vol > 0, short_trend, long_trend)\n    return df_copy['factor_trend_volume_switch']",
