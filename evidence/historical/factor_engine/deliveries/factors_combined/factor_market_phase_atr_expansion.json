  "code": "def factor_market_phase_atr_expansion(df):\n    df_copy = df.copy()\n    import talib\n    true_range = talib.TRANGE(df_copy['high'], df_copy['low'], df_copy['close'])\n    atr = true_range.rolling(20).mean()\n    atr_long_mean = atr.rolling(120).mean()\n    signal = atr / atr_long_mean\n    signal = signal.fillna(1.0)\n    signal.name = 'factor_market_phase_atr_expansion'\n    return signal",
