  "code": "def factor_drawdown_recovery_vol_adjusted_skew_modulated(df):\n    df_copy = df.copy()\n    high = df_copy['high']\n    low = df_copy['low']\n    close = df_copy['close']\n    rolling_max = close.rolling(window=252, min_periods=20).max()\n    drawdown = (close - rolling_max) / rolling_max\n    tr = np.maximum(high - low,\n                    np.maximum((high - low.shift(1)).abs(),\n                               (low - high.shift(1)).abs()))\n    atr = tr.rolling(window=20, min_periods=10).mean()\n    normalizer = atr / close\n    normalizer = normalizer.replace(0, np.nan)\n    base_factor = -drawdown / normalizer\n    # Skew stress from second parent\n    returns = close.pct_change()\n    skew = returns.rolling(window=63, min_periods=30).skew()\n    left_tail = (-skew).clip(lower=0).fillna(0)\n    factor = base_factor * (1 + 0.3 * left_tail)\n    factor = factor.fillna(0)\n    factor_arr = talib.EMA(factor.values, timeperiod=5)\n    factor = pd.Series(factor_arr, index=df_copy.index).fillna(0)\n    factor.name = 'factor_drawdown_recovery_vol_adjusted_skew_modulated'\n    return factor",
