  "code": "def factor_price_impact_volatility_adjusted(df):\n    df_copy = df.copy()\n    close = df_copy['close']\n    volume = df_copy['volume']\n    ret = close / close.shift(1) - 1.0\n    abs_ret = ret.abs()\n    # Rolling average of absolute return per unit volume (price impact)\n    impact = abs_ret / volume.replace(0, np.nan)\n    avg_impact = impact.rolling(20, min_periods=20).mean()\n    # Rolling volatility of returns\n    vol = ret.rolling(20, min_periods=20).std(ddof=1).replace(0, np.nan)\n    # Volatility-adjusted impact\n    factor = avg_impact / vol\n    factor = factor.replace([np.inf, -np.inf], np.nan).fillna(0)\n    df_copy['factor_price_impact_volatility_adjusted'] = factor\n    return df_copy['factor_price_impact_volatility_adjusted']",
