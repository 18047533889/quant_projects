  "code": "def factor_price_impact_vol_adjusted_ema(df):\n    df_copy = df.copy()\n    close = df_copy['close']\n    volume = df_copy['volume']\n    ret = close / close.shift(1) - 1.0\n    abs_ret = ret.abs()\n    impact = abs_ret / volume.replace(0, np.nan)\n    avg_impact = impact.ewm(span=20, min_periods=20).mean()\n    vol = ret.ewm(span=20, min_periods=20).std()\n    factor = avg_impact / vol.replace(0, np.nan)\n    factor = factor.replace([np.inf, -np.inf], np.nan).fillna(0)\n    df_copy['factor_price_impact_vol_adjusted_ema'] = factor\n    return df_copy['factor_price_impact_vol_adjusted_ema']",
