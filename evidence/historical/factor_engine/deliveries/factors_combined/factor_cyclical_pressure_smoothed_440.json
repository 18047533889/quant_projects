  "code": "def factor_cyclical_pressure_smoothed(df):\n    df_copy = df.copy()\n    high_low = df_copy[\"high\"] - df_copy[\"low\"]\n    high_pc = (df_copy[\"high\"] - df_copy[\"close\"].shift(1)).abs()\n    low_pc = (df_copy[\"low\"] - df_copy[\"close\"].shift(1)).abs()\n    true_range = pd.concat([high_low, high_pc, low_pc], axis=1).max(axis=1)\n    atr_ema = talib.EMA(true_range.values.astype(np.float64), timeperiod=90)\n    atr_ema = pd.Series(atr_ema, index=df_copy.index)\n    atr_change = atr_ema / atr_ema.shift(20) - 1\n    return atr_change.fillna(0).rename('factor_cyclical_pressure_smoothed')",
