  "code": "def factor_price_smoothness(df):\n    df_copy = df.copy()\n    # Daily return magnitude relative to intraday range\n    daily_ret = df_copy[\"close\"] / df_copy[\"close\"].shift(1) - 1\n    daily_range = df_copy[\"high\"] - df_copy[\"low\"]\n    # Ratio of squared return to squared range; small when price moves smoothly within range\n    smoothness_ratio = (daily_ret ** 2) / (daily_range ** 2).replace(0, np.nan)\n    # Rolling average of smoothness ratio over 20 days\n    avg_ratio = smoothness_ratio.rolling(20, min_periods=10).mean()\n    # Negative so high factor = smooth\n    factor = -avg_ratio\n    df_copy[\"factor_price_smoothness\"] = factor\n    return df_copy[\"factor_price_smoothness\"]",
