  "code": "def factor_drawdown_stress_ratio_ewm(df):\n    df_copy = df.copy()\n    close = df_copy['close']\n    running_max = close.cummax()\n    drawdown = (running_max - close) / running_max\n    # exponential weighted mean of drawdown over 60-day span\n    drawdown_ewm = drawdown.ewm(span=60, min_periods=60, adjust=False).mean()\n    returns = close.pct_change()\n    vol = returns.rolling(60, min_periods=60).std(ddof=1)\n    factor = drawdown_ewm / vol.replace(0.0, np.nan)\n    factor = factor.fillna(0.0)\n    factor.name = \"factor_drawdown_stress_ratio_ewm\"\n    return factor",
