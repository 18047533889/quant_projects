  "code": "def factor_amount_weighted_impact(df):\n    df_copy = df.copy()\n    ret = df_copy['close_price'].pct_change().fillna(0.0)\n    abs_ret = ret.abs()\n    amount = df_copy['amount']\n    total_amount = amount.sum()\n    if total_amount > 0:\n        impact = (abs_ret * amount).sum() / total_amount\n    else:\n        impact = 0.0\n    day = pd.Timestamp(df_copy['TradingDay'].iloc[0])\n    out = pd.Series([impact], index=[day], name='factor_amount_weighted_impact')\n    return out",
