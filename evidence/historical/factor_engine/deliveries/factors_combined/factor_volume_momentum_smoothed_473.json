  "code": "def factor_volume_momentum_smoothed(df):\n    df_copy = df.copy()\n    vol = df_copy[\"volume\"]\n    short_window = 10\n    long_window = 30\n    vol_sma_short = vol.rolling(short_window, min_periods=short_window).mean()\n    vol_sma_long = vol.rolling(long_window, min_periods=long_window).mean()\n    momentum = (vol_sma_short - vol_sma_long) / vol_sma_long.replace(0, np.nan)\n    momentum = momentum.fillna(0)\n    smoothed = momentum.ewm(span=5, min_periods=5, adjust=False).mean()\n    df_copy[\"factor_volume_momentum_smoothed\"] = smoothed\n    return df_copy[\"factor_volume_momentum_smoothed\"]",
