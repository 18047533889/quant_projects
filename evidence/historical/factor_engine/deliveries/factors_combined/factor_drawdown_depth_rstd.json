  "code": "def factor_drawdown_depth_rstd(df):\n    df_copy = df.copy()\n    peak = df_copy[\"close\"].rolling(42, min_periods=42).max()\n    dd = (df_copy[\"close\"] - peak) / peak\n    depth = (-dd)\n    returns = df_copy[\"close\"].pct_change()\n    vol = returns.rolling(21, min_periods=21).std(ddof=1)\n    normalized_depth = depth / vol.replace(0, np.nan)\n    factor = normalized_depth.fillna(0)\n    df_copy[\"factor_drawdown_depth_rstd\"] = factor\n    return df_copy[\"factor_drawdown_depth_rstd\"]",
