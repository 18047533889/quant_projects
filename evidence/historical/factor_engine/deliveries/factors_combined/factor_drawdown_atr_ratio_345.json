  "code": "def factor_drawdown_atr_ratio(df):\n    df_copy = df.copy()\n    rolling_max = df_copy['close'].rolling(20, min_periods=10).max()\n    max_drawdown_20 = (df_copy['close'] - rolling_max) / rolling_max\n    atr = talib.ATR(df_copy['high'], df_copy['low'], df_copy['close'], timeperiod=20)\n    stress_ratio = -max_drawdown_20 / atr.replace(0.0, np.nan)\n    df_copy['factor_drawdown_atr_ratio'] = stress_ratio.fillna(0.0)\n    return df_copy['factor_drawdown_atr_ratio']",
