  "code": "def factor_persistent_left_tail_variance_share(df):\n    \"\"\"Persistent exponentially weighted share of realized variance from negative returns.\"\"\"\n    df_copy = df.copy()\n    ret = df_copy[\"close\"].pct_change()\n    downside_variance = ret.clip(upper=0.0).pow(2).ewm(span=45, min_periods=30, adjust=False).mean()\n    total_variance = ret.pow(2).ewm(span=45, min_periods=30, adjust=False).mean()\n    df_copy[\"factor_persistent_left_tail_variance_share\"] = downside_variance / total_variance.replace(0.0, np.nan)\n    return df_copy[\"factor_persistent_left_tail_variance_share\"]",
