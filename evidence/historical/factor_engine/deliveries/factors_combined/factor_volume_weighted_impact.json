  "code": "def factor_volume_weighted_impact(df):\n    df_copy = df.copy()\n    ret = df_copy['close_price'].pct_change().fillna(0.0)\n    abs_ret = ret.abs()\n    volume = df_copy['volume']\n    total_volume = volume.sum()\n    if total_volume > 0:\n        impact = (abs_ret * volume).sum() / total_volume\n    else:\n        impact = 0.0\n    day = pd.Timestamp(df_copy['TradingDay'].iloc[0])\n    out = pd.Series([impact], index=[day], name='factor_volume_weighted_impact')\n    return out",
