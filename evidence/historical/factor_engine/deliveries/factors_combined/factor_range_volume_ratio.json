  "code": "def factor_range_volume_ratio(df):\n    df_copy = df.copy()\n    range_ratio = (df_copy['high'] - df_copy['low']) / df_copy['close']\n    vol_ratio = df_copy['volume'] / df_copy['volume'].rolling(20).mean().replace(0, np.nan)\n    factor = range_ratio * vol_ratio\n    factor.name = 'factor_range_volume_ratio'\n    return factor",
