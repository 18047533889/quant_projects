  "code": "def factor_leveraged_sales_yield(df):\n    df_copy = df.copy()\n    sales_yield = 1.0 / df_copy[\"ps_ttm\"].replace(0, np.nan)\n    debt_ratio = df_copy[\"debttoassets\"] / 100.0\n    safety = (1.0 - debt_ratio).clip(0, 1)\n    factor = sales_yield * safety\n    factor = factor.ffill()\n    df_copy[\"factor_leveraged_sales_yield\"] = factor\n    return df_copy[\"factor_leveraged_sales_yield\"]",
