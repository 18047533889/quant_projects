  "code": "def factor_downside_semivariance_smoothed(df):\n    \"\"\"Smoothed trailing concentration of return variance in downside outcomes.\"\"\"\n    df_copy = df.copy()\n    ret = df_copy[\"close\"].pct_change()\n    downside_sq = ret.clip(upper=0.0).pow(2).rolling(20, min_periods=20).mean()\n    total_sq = ret.pow(2).rolling(20, min_periods=20).mean()\n    concentration = downside_sq / total_sq.replace(0.0, np.nan)\n    df_copy[\"factor_downside_semivariance_smoothed\"] = concentration.ewm(span=5, adjust=False, min_periods=5).mean()\n    return df_copy[\"factor_downside_semivariance_smoothed\"]",
  "cross_sectional_rationale": "Tail-loss concentration remains economically meaningful relative to same-day peers. Robust standardization limits the influence of unusually extreme crash-exposed names while preserving relative fragility.",
