  "code": "def factor_drawdown_depth_atr(df):\n    df_copy = df.copy()\n    peak = df_copy[\"close\"].rolling(63, min_periods=63).max()\n    dd = (df_copy[\"close\"] - peak) / peak\n    depth = (-dd)\n    high_low = df_copy[\"high\"] - df_copy[\"low\"]\n    high_close = (df_copy[\"high\"] - df_copy[\"close\"].shift(1)).abs()\n    low_close = (df_copy[\"low\"] - df_copy[\"close\"].shift(1)).abs()\n    tr = pd.concat([high_low, high_close, low_close], axis=1).max(axis=1)\n    atr = tr.rolling(63, min_periods=63).mean()\n    normalized_depth = depth / atr.replace(0, np.nan)\n    factor = normalized_depth.fillna(0)\n    df_copy[\"factor_drawdown_depth_atr\"] = factor\n    return df_copy[\"factor_drawdown_depth_atr\"]",
