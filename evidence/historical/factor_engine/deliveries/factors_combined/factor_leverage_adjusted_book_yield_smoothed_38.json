  "code": "def factor_leverage_adjusted_book_yield_smoothed(df):\n    df_copy = df.copy()\n    book_yield = 1.0 / df_copy[\"pb_lf\"].replace(0, np.nan)\n    smooth_book_yield = book_yield.rolling(5, min_periods=3).mean()\n    debt_ratio = df_copy[\"debttoassets\"] / 100.0\n    adjustment = np.clip(1.0 - debt_ratio, 0.0, 1.0)\n    factor = smooth_book_yield * adjustment\n    factor = factor.fillna(0.0)\n    df_copy[\"factor_leverage_adjusted_book_yield_smoothed\"] = factor\n    return df_copy[\"factor_leverage_adjusted_book_yield_smoothed\"]",
