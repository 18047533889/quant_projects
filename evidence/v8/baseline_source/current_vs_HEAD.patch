+        corr = float(stats.spearmanr(x_valid, y_valid)[0])
+    if not np.isfinite(corr):
+        return None, PairwiseMeasurementStatus.INVALID, valid_mask
+    return corr, PairwiseMeasurementStatus.COMPUTED, valid_mask
