+def batched_membership_turnover(factor_values, quantile=.9):
+    """CPU temporal.compute_factor_turnover_rate semantics, shape (T-1,F).
+
+    This diagnostic uses the jointly observed universe, not executed trades.
+    Its denominator is the joint security count, not gross traded notional.
+    """
+    cp = _import_cp()
+    if not 0 < quantile < 1:
+        raise ValueError("quantile must be in (0,1)")
+    x = cp.asarray(factor_values)
+    joint = cp.isfinite(x[:-1]) & cp.isfinite(x[1:])
+    before = cp.where(joint, x[:-1], cp.nan)
+    after = cp.where(joint, x[1:], cp.nan)
+    count = joint.sum(axis=2)
+    def cutoff(values):
+        ordered = cp.sort(cp.where(joint, values, cp.inf), axis=2)
+        position = quantile * cp.maximum(count - 1, 0)
+        lo = cp.floor(position).astype(cp.int64)
+        hi = cp.minimum(lo + 1, cp.maximum(count - 1, 0))
+        left = cp.take_along_axis(ordered, lo[:, :, None], axis=2)
+        right = cp.take_along_axis(ordered, hi[:, :, None], axis=2)
+        return left + (position - lo)[:, :, None] * (right - left)
+    before_cut = cutoff(before)
+    after_cut = cutoff(after)
+    if quantile > .5:
+        old, new = before >= before_cut, after >= after_cut
+    else:
+        old, new = before <= before_cut, after <= after_cut
+    return cp.where(count >= 10, ((old != new) & joint).sum(axis=2) / cp.maximum(count, 1), cp.nan)
