+    thr[0] = np.nanquantile(col[:1], qt)
+    if rows > 1:
+        lead = _win_pad_rows(col, max(w - 1, 1))
+        thr[1:] = _rolling_quantile(lead, np.array([qt]))[: rows - 1, 0]
+    return thr
