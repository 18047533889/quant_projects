+        keys = key[trans_ok]
+        dx = inc[trans_ok]
+        total = rows * B
+        cnt = np.bincount(keys, minlength=total).reshape(rows, B).astype(float)
+        sums = np.bincount(keys, weights=dx, minlength=total).reshape(rows, B)
+        sqs = np.bincount(keys, weights=dx * dx, minlength=total).reshape(rows, B)
