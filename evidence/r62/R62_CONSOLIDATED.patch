+    for c in range(cols):
+        col = x2d[:, c]
+        rec, old = _two_window_pads(col, ws, wl)
+        Rp = np.isfinite(rec)
+        Op = np.isfinite(old)
+        cnt_r = Rp.sum(axis=1)
+        cnt_o = Op.sum(axis=1)
+        fin = np.isfinite(col)
