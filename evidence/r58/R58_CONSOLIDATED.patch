+# ---------------------------------------------------------------------------
+# R44 warm-up: kernel-truth bounded-window declarations
+#
+# These 148 window operators were fail-closed to ``_UNKNOWN`` by the R19-078
+# production-direct guard in ``_default_window_extension`` (they declare a
+# window-like param but carry no explicit transform), and
+# ``history_requirement`` turns ``_UNKNOWN`` into ``kind='full_history'``.  For a
+# plain W-bar trailing re-read that is a whole-history replay: the planner's load
+# window collapses to the dataset origin instead of ``W`` extra bars, and in a
+# bulk DAG materialisation that single mis-declaration dominates the scan cost of
+# every factor containing the operator.
+#
+# The horizon below is the KERNEL's own, not a name guess.  It was measured by
+# prefix-truncation convergence: compute the operator on a panel holding only the
+# last K rows and find the first row index whose value already equals the
+# full-panel value.  Truncation can only remove history, so for a bounded
+# operator everything at or after the true horizon must match; a recursive
+# operator keeps differing all the way to the last row.  Each operator was
+# measured at TWO window settings (W=20 and W=41) and is listed here only when
+# its horizon grew exactly 1:1 with the bound window — i.e. ``horizon == W``.
+# The declaration is therefore EXACT: these kernels never read further back than
+# their own window, so no emitted value changes.
+#
+# Deliberately NOT listed (they keep full-history semantics):
+#   * recursion that converges only after hundreds of bars - DEMA, TEMA, NATR,
+#     ATR_WILDER, DMI_plus, ForceIndex, atr_pct, ts_leverage_effect, ema_*,
+#     PVO/PPO/TSI families (horizon grew ~10x the window, or is window-invariant);
+#   * operators whose measured horizon did not respond to the window parameter
+#     (the probe cannot prove boundedness -> not evidence);
+#   * operators the synthetic probe could not drive at all.
+# Those remain reported as migration debt by ``history_fallback_canonicals``.
+# ---------------------------------------------------------------------------
+def _bounded_window_rows(canonical: str, params: Mapping[str, Any]) -> int | object:
+    """Warm-up rows for an operator whose backward horizon equals its window.
+
+    Returns the MAX bound value among the operator's declared window-like
+    params, i.e. the operator needs ``W`` prior rows before it can emit its first
+    correct value.  ``W`` rather than ``W - 1`` is deliberate: the measured
+    horizon is ``W`` for the shift-then-roll family and ``W - 1`` for the plain
+    rolling family, and a one-row over-declaration costs a single row of scan
+    whereas an under-declaration silently emits an immature value (the failure
+    mode this section exists to remove).  A fractional or un-resolvable bound
+    fails closed to ``_UNKNOWN`` (full history), never to a truncated guess.
+    """
+    meta = _metadata(canonical)
+    if meta is None:
+        return _UNKNOWN
+    specs = getattr(meta, "param_specs", None) or {}
+    names = tuple(getattr(meta, "param_names", None) or ())
+    best = 0
+    resolved = False
+    for name in names:
+        if name not in _WINDOW_LIKE_PARAM_NAMES:
+            continue
+        value = _bound_param(params, name, specs, canonical=canonical)
