# quant_projects 环境变量示例（复制为 .env 后填写，勿提交密钥）

# ClickHouse（factor_engine SQL 下推 / materialize_clickhouse）
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=0

# 可选：GitHub Personal Access Token（git push / gh）
# GITHUB_TOKEN=ghp_xxx

# 可选：LQTP 因子服务 gRPC（复制到 .env，勿提交密码）
# LQTP_SERVER=110.42.223.26:50051
# LQTP_USERNAME=your@email.com
# LQTP_PASSWORD=your_password

# QUANT_PROJECTS_ROOT=/path/to/quant_projects
# FACTOR_LAKE_ROOT=/path/to/factors/lake
# FACTOR_ENGINE_OPERATOR_BACKEND=auto
