# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/

# 测试 / 工具缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 数据与运行时产物（parquet 不同步，迁移后从 COS/本地重新拉取）
**/*.parquet
data/a_share/lqtp_data/**
data/us_stock/**
data/factors/lake/_runs/**
data/factors/lake/factors/**
data/factors/lake/gtja191/factors/**
data/cache/**
data/.cos_remote_cache*/
data/staging/**
logs/**
output/**
*.nohup
*.log

# macOS / IDE
.DS_Store
.idea/
.vscode/
*.swp

# 个人 workspace / 运行时数据（公共代码必须在仓库顶层 data_access/ factor_engine/）
workspaces/
workspace_data/
factor_engine/util/workspace_data/
.scheduled_*.ready

# 敏感信息（R24 P1-S7 §9：coscli 配置 / credential / secret / key 文件不入库）
# 注意：只忽略「凭证材料」后缀，绝不用 `credentials.*` 这类会吞掉源码
# （credentials.py）的模式。R26 §9.2：任何 production *.py 被 ignore 必须 CI fail。
.env
*.pem
*_token*
**/lqtp_platform_full_response.json
.cos.yaml
cos.yaml
*.credentials
*.secret
*.key
*.s3cred
*secret_key*
*secret_id*
# credentials.py 是纯源码（无真实 secret），必须纳入 Git（R26-P0-001）。
!dataaccess/security/credentials.py

# 本地备份 / 可重建缓存 / 体积过大产物
.replace_backup_*/
**/*.bak_*
**/*.bak
data/**/eval_cache/
data/**/factor_lake/
data/**/lqtp_*_returns_cache.parquet*
*.tar.gz
coscli_output/

# 自引用 symlink（避免把 reports/reports 打进仓库）
data/**/reports/reports

# 文档构建产物
docs/team_docs/node_modules/

# Loop stop switch (local only)
loop/HALT

